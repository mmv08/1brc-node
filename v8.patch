+namespace v8::internal::compiler {
+
+class NodeMarkerTest : public TestWithZone {
+ protected:
+  TFGraph graph_{zone()};
+  CommonOperatorBuilder common_{zone()};
+};
+
+TEST_F(NodeMarkerTest, CompareAllStates) {
+  Node* node = graph_.NewNode(common_.Int32Constant(0));
+  // Exercise current states with both zero and nonzero epoch offsets, including
+  // offsets larger than the State type can represent.
+  for (int epoch = 0; epoch < 130; ++epoch) {
+    NodeMarker<uint8_t> marker(&graph_, 4);
+    for (uint8_t state = 0; state < 4; ++state) {
+      marker.Set(node, state);
+      for (uint8_t other = 0; other < 4; ++other) {
+        EXPECT_EQ(state == other, marker.Is(node, other));
+        EXPECT_EQ(state > other, marker.IsGreaterThan(node, other));
+      }
+    }
+  }
+}
+
+TEST_F(NodeMarkerTest, UntouchedNodesHaveStateZero) {
+  Node* old_node = graph_.NewNode(common_.Int32Constant(0));
+  NodeMarker<uint8_t> marker(&graph_, 4);
+  Node* new_node = graph_.NewNode(common_.Int32Constant(1));
+  for (Node* node : {old_node, new_node}) {
+    for (uint8_t other = 0; other < 4; ++other) {
+      EXPECT_EQ(other == 0, marker.Is(node, other));
+      EXPECT_FALSE(marker.IsGreaterThan(node, other));
+    }
+  }
+}
+
+TEST_F(NodeMarkerTest, PreviousEpochsHaveStateZero) {
+  Node* nodes[4];
+  NodeMarker<uint8_t> first(&graph_, 4);
+  for (uint8_t state = 0; state < 4; ++state) {
+    nodes[state] = graph_.NewNode(common_.Int32Constant(state));
+    first.Set(nodes[state], state);
+  }
+  // Include epoch differences that cannot be represented by the State type.
+  for (int epoch = 0; epoch < 130; ++epoch) {
+    NodeMarker<uint8_t> marker(&graph_, 4);
+    for (Node* node : nodes) {
+      for (uint8_t other = 0; other < 4; ++other) {
+        EXPECT_EQ(other == 0, marker.Is(node, other));
+        EXPECT_FALSE(marker.IsGreaterThan(node, other));
+      }
+    }
+  }
+}
+
+}  // namespace v8::internal::compiler
