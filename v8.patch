+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/compiler/sparse-sidetable.h"
+
+#include "src/compiler/common-operator.h"
+#include "test/unittests/test-utils.h"
+
+namespace v8::internal::compiler {
+
+class SparseSidetableTest : public TestWithZone {
+ protected:
+  Node* NewNode(NodeId id) {
+    return Node::New(zone(), id, common_.Int32Constant(0), 0, nullptr, false);
+  }
+  CommonOperatorBuilder common_{zone()};
+};
+
+TEST_F(SparseSidetableTest, MissingOperationsDoNotAllocate) {
+  Node* low = NewNode(0);
+  Node* high = NewNode(65535);
+  SparseSidetable<int> table(zone(), -1);
+  size_t before = zone()->allocation_size();
+  for (Node* node : {low, high}) {
+    EXPECT_EQ(-1, table.Get(node));
+    table.Set(node, -1);
+    EXPECT_EQ(-1, table.Get(node));
+  }
+  EXPECT_EQ(before, zone()->allocation_size());
+}
+
+TEST_F(SparseSidetableTest, SparseGrowthPreservesReferences) {
+  Node* first = NewNode(0);
+  Node* adjacent = NewNode(1);
+  Node* boundary = NewNode(63);
+  Node* next = NewNode(64);
+  Node* high = NewNode(65535);
+  SparseSidetable<int> table(zone(), -1);
+  const int& missing = table.Get(first);
+  table.Set(first, 7);
+  const int& stored = table.Get(first);
+  for (Node* node : {adjacent, boundary, next, high}) {
+    EXPECT_EQ(-1, table.Get(node));
+    table.Set(node, static_cast<int>(node->id()));
+  }
+  EXPECT_EQ(-1, missing);
+  EXPECT_EQ(7, stored);
+  EXPECT_EQ(&stored, &table.Get(first));
+  for (Node* node : {adjacent, boundary, next, high}) {
+    EXPECT_EQ(static_cast<int>(node->id()), table.Get(node));
+  }
+  table.Set(first, -1);
+  EXPECT_EQ(-1, stored);
+  EXPECT_EQ(&stored, &table.Get(first));
+  EXPECT_NE(&missing, &table.Get(first));
+  table.Set(first, 9);
+  EXPECT_EQ(9, stored);
+  EXPECT_EQ(-1, missing);
+}
+
+TEST_F(SparseSidetableTest, MissingSlotSharesDefaultInAllocatedChunk) {
+  Node* first = NewNode(0);
+  Node* missing_node = NewNode(1);
+  Node* remote = NewNode(4096);
+  SparseSidetable<int> table(zone(), -1);
+  table.Set(first, 7);
+  const int& missing = table.Get(missing_node);
+  EXPECT_EQ(&missing, &table.Get(remote));
+  size_t before = zone()->allocation_size();
+  table.Set(missing_node, -1);
+  EXPECT_EQ(before, zone()->allocation_size());
+  EXPECT_EQ(&missing, &table.Get(missing_node));
+  table.Set(missing_node, 8);
+  EXPECT_EQ(-1, missing);
+  EXPECT_EQ(8, table.Get(missing_node));
+}
+
+TEST_F(SparseSidetableTest, NonDefaultConstructibleValue) {
+  struct Value {
+    explicit Value(int value) : value(value) {}
+    bool operator!=(const Value& other) const { return value != other.value; }
+    int value;
+  };
+  Node* first = NewNode(0);
+  Node* high = NewNode(4096);
+  SparseSidetable<Value> table(zone(), Value(-1));
+  table.Set(first, Value(7));
+  const Value& stored = table.Get(first);
+  table.Set(high, Value(8));
+  EXPECT_EQ(7, stored.value);
+  EXPECT_EQ(8, table.Get(high).value);
+  table.Set(first, Value(-1));
+  EXPECT_EQ(-1, stored.value);
+}
+
+}  // namespace v8::internal::compiler
