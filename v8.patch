--- /dev/null
+++ b/src/compiler/sparse-sidetable.h
@@ -0,0 +1,80 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef V8_COMPILER_SPARSE_SIDETABLE_H_
+#define V8_COMPILER_SPARSE_SIDETABLE_H_
+
+#include <array>
+#include <type_traits>
+#include <utility>
+
+#include "src/base/template-utils.h"
+#include "src/compiler/node.h"
+#include "src/zone/zone-containers.h"
+
+namespace v8::internal::compiler {
+
+// Node-indexed storage with allocation-free missing reads and default writes.
+// Chunks keep references stable when the index grows. The presence bits retain
+// the distinction between a missing entry and a stored default value.
+template <class T>
+class SparseSidetable {
+ public:
+  explicit SparseSidetable(Zone* zone, T def_value = T())
+      : def_value_(std::move(def_value)), chunks_(zone), zone_(zone) {}
+  SparseSidetable(const SparseSidetable&) = delete;
+  SparseSidetable& operator=(const SparseSidetable&) = delete;
+
+  void Set(const Node* node, T value) {
+    const size_t index = node->id() / kChunkSize;
+    const size_t slot = node->id() % kChunkSize;
+    Chunk* chunk = index < chunks_.size() ? chunks_[index] : nullptr;
+    if (chunk && chunk->Contains(slot)) {
+      chunk->values[slot] = std::move(value);
+      return;
+    }
+    if (!(value != def_value_)) return;
+    if (!chunk) {
+      if (index >= chunks_.size()) chunks_.resize(index + 1, nullptr);
+      chunk = zone_->New<Chunk>(def_value_);
+      chunks_[index] = chunk;
+    }
+    chunk->values[slot] = std::move(value);
+    chunk->present |= uint64_t{1} << slot;
+  }
+
+  const T& Get(const Node* node) const {
+    const size_t index = node->id() / kChunkSize;
+    if (index < chunks_.size()) {
+      const Chunk* chunk = chunks_[index];
+      const size_t slot = node->id() % kChunkSize;
+      if (chunk && chunk->Contains(slot)) return chunk->values[slot];
+    }
+    return def_value_;
+  }
+
+ private:
+  static constexpr size_t kChunkSize = 64;
+  static_assert(std::is_trivially_destructible_v<T>);
+
+  struct Chunk {
+    explicit Chunk(const T& def_value)
+        : values(
+              base::make_array<kChunkSize>([&](size_t) { return def_value; })) {
+    }
+    bool Contains(size_t slot) const {
+      return (present & (uint64_t{1} << slot)) != 0;
+    }
+    uint64_t present = 0;
+    std::array<T, kChunkSize> values;
+  };
+
+  T def_value_;
+  ZoneVector<Chunk*> chunks_;
+  Zone* const zone_;
+};
+
+}  // namespace v8::internal::compiler
+
+#endif  // V8_COMPILER_SPARSE_SIDETABLE_H_
