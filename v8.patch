+bool LoopPeeler::CollectTerminatingNodes(LoopTree::Loop* loop,
+                                         NodeVector* nodes) {
+  DCHECK(nodes->empty());
+  Node* loop_node = loop_tree_->GetLoopControl(loop);
+  auto is_own_exit = [&](Node* node) {
+    if (node->opcode() == IrOpcode::kLoopExit) {
+      return node->InputAt(1) == loop_node;
+    }
+    if (node->opcode() == IrOpcode::kLoopExitValue ||
+        node->opcode() == IrOpcode::kLoopExitEffect) {
+      return NodeProperties::GetControlInput(node)->InputAt(1) == loop_node;
+    }
+    return false;
+  };
+  ZoneUnorderedSet<Node*> visited(tmp_zone_);
+  auto enqueue = [&](Node* node) {
+    if (visited.find(node) != visited.end()) return true;
+    // Bound the frontier as well as the eventual copied region. With no
+    // escaping uses, leave the existing caller's size policy unchanged.
+    if (loop->TotalSize() + nodes->size() >= kMaxPeeledNodes) return false;
+    visited.insert(node);
+    nodes->push_back(node);
+    return true;
+  };
+
+  // Keep the usual marked-exit requirement. Additionally, a terminal side
+  // path can be copied together with the body, without merging it back into
+  // the loop. Collect every escaping use, including frame-state values.
+  for (Node* node : loop_tree_->LoopNodes(loop)) {
+    if (is_own_exit(node)) continue;
+    for (Node* use : node->uses()) {
+      if (!loop_tree_->Contains(loop, use) &&
+          use->opcode() != IrOpcode::kTerminate) {
+        if (!enqueue(use)) return false;
+      }
+    }
+  }
+
+  for (size_t i = 0; i < nodes->size(); ++i) {
+    Node* node = (*nodes)[i];
+    // Do not absorb another loop, ordinary exits, or an unrelated terminal.
+    if (loop_tree_->ContainingLoop(node) != nullptr ||
+        node->opcode() == IrOpcode::kLoop ||
+        node->opcode() == IrOpcode::kLoopExit ||
+        node->opcode() == IrOpcode::kReturn ||
+        node->opcode() == IrOpcode::kTerminate ||
+        node->opcode() == IrOpcode::kEnd || node->uses().empty()) {
+      return false;
+    }
+    for (Node* use : node->uses()) {
+      if (node->opcode() == IrOpcode::kThrow && use == graph_->end()) {
+        continue;
+      }
+      if (loop_tree_->Contains(loop, use)) return false;
+      if (!enqueue(use)) return false;
+    }
+  }
+
+  // Retained external inputs must not depend indirectly on this loop's exits
+  // either. Enclosing loop headers are invariant during one execution of this
+  // loop: their backedges belong to the next enclosing iteration, so do not
+  // follow them back into this loop. Other external dependencies are checked
+  // transitively, with a separate bound on the validation work.
+  auto is_enclosing_header = [&](Node* node) {
+    Node* header = node;
+    if (NodeProperties::IsPhi(node)) {
+      header = NodeProperties::GetControlInput(node);
+    }
+    if (header->opcode() != IrOpcode::kLoop) return false;
+    LoopTree::Loop* header_loop = loop_tree_->ContainingLoop(header);
+    for (LoopTree::Loop* parent = loop->parent(); parent != nullptr;
+         parent = parent->parent()) {
+      if (header_loop == parent) return true;
+    }
+    return false;
+  };
+  ZoneUnorderedSet<Node*> checked_inputs(tmp_zone_);
+  NodeVector external_inputs(tmp_zone_);
+  auto enqueue_external_input = [&](Node* node) {
+    if (is_own_exit(node)) return false;
+    if (is_enclosing_header(node) ||
+        checked_inputs.find(node) != checked_inputs.end()) {
+      return true;
+    }
+    if (external_inputs.size() >= kMaxPeeledNodes) return false;
+    checked_inputs.insert(node);
+    external_inputs.push_back(node);
+    return true;
+  };
+
+  // In particular, reject a merge with a path originating outside this loop:
+  // copying that merge would execute its other predecessor twice. All
+  // control inputs must belong to the body or the collected terminal region.
+  for (Node* node : *nodes) {
+    // This loop's exit markers are merged after copying, not mapped by the
+    // NodeCopier. A copied control, value, or effect input must not still
+    // reference such a shared exit. Child-loop exits are part of the body.
+    for (Node* input : node->inputs()) {
+      if (is_own_exit(input)) return false;
+      if (!loop_tree_->Contains(loop, input) &&
+          visited.find(input) == visited.end() &&
+          !enqueue_external_input(input)) {
+        return false;
+      }
+    }
+    for (int i = 0; i < node->op()->ControlInputCount(); ++i) {
+      Node* control = NodeProperties::GetControlInput(node, i);
+      if (!loop_tree_->Contains(loop, control) &&
+          visited.find(control) == visited.end()) {
+        return false;
+      }
+    }
+  }
+  for (size_t i = 0; i < external_inputs.size(); ++i) {
+    for (Node* input : external_inputs[i]->inputs()) {
+      // An uncopied predecessor cannot retain an input tied to the original
+      // iteration, even if that input itself would be mapped when copying.
+      if (loop_tree_->Contains(loop, input) ||
+          visited.find(input) != visited.end() ||
+          !enqueue_external_input(input)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
