+Reduction JSCallReducer::ReduceArrayBufferByteLengthAccessor(Node* node) {
+  JSCallNode n(node);
+  Effect effect = n.effect();
+  TNode<JSArrayBuffer> receiver =
+      TNode<JSArrayBuffer>::UncheckedCast(n.receiver());
+  MapInference inference(broker(), receiver, effect);
+  if (!inference.HaveMaps() ||
+      !inference.AllOfInstanceTypesAre(JS_ARRAY_BUFFER_TYPE) ||
+      !inference.RelyOnMapsViaStability(dependencies())) {
+    return inference.NoChange();
+  }
+
+  JSCallReducerAssembler a(this, node, effect);
+  TNode<Word32T> bit_field = a.EnterMachineGraph<Word32T>(
+      a.LoadField<Word32T>(AccessBuilder::ForJSArrayBufferBitField(), receiver),
+      UseInfo::TruncatingWord32());
+  // ArrayBuffers and SharedArrayBuffers have the same instance type.
+  // Keep the builtin's throwing path rather than speculatively deoptimizing:
+  // getter calls need not have a CALL_IC slot to
+  // prevent deoptimization loops.
+  TNode<Word32T> is_shared = a.Word32And(
+      bit_field, a.Int32Constant(JSArrayBuffer::Bits::IsSharedBit::kMask));
+  a.MachineIf(is_shared)
+      .Then([&] {
+        Callable callable = CodeFactory::CallFunction(
+            isolate(), ConvertReceiverMode::kNotNullOrUndefined);
+        auto descriptor = Linkage::GetStubCallDescriptor(
+            graph()->zone(), callable.descriptor(), 1,
+            CallDescriptor::kNeedsFrameState);
+        a.MayThrow([&] {
+          return a.AddNode<Object>(graph()->NewNode(
+              common()->Call(descriptor),
+              jsgraph()->HeapConstantNoHole(callable.code()), n.target(),
+              jsgraph()->ConstantNoHole(JSParameterCount(0)), receiver,
+              n.context(), n.frame_state(), a.effect(), a.control()));
+        });
+        a.Unreachable();
+      })
+      .ExpectFalse();
+
+  // This mutable field is updated by both resizing and detachment (to zero).
+  TNode<UintPtrT> value = a.EnterMachineGraph<UintPtrT>(
+      a.LoadField<UintPtrT>(AccessBuilder::ForJSArrayBufferByteLength(),
+                            receiver),
+      UseInfo::Word());
+  TNode<Number> result = a.ExitMachineGraph<Number>(
+      value, MachineType::PointerRepresentation(),
+      TypeCache::Get()->kJSArrayBufferByteLengthType);
+  return ReplaceWithSubgraph(&a, result);
+}
