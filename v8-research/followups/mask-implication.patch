From 5f9782e9934ce530bb7e1ddeccda9a9c8ea258c3 Mon Sep 17 00:00:00 2001
From: Mikhail Mikheev <16622558+mmv08@users.noreply.github.com>
Date: Wed, 21 Oct 2026 09:47:02 +0000
Subject: [PATCH 1/4] [turboshaft] Eliminate implied zero-mask guards

Track zero bits established by successful Word32 mask deopt guards.
A later mask of the same SSA value is zero when its bits are a subset.
Scope the first fact per value to the existing dominator layers, and
conservatively forget guard facts when replaying cloned predecessors.

TAG=agy
CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 .../turboshaft/branch-elimination-reducer.h   |  41 ++++
 .../turboshaft/deoptimize-if-zero-mask.js     |  67 ++++++
 .../turboshaft/control-flow-unittest.cc       | 223 ++++++++++++++++++
 3 files changed, 331 insertions(+)
 create mode 100644 test/mjsunit/turboshaft/deoptimize-if-zero-mask.js

diff --git a/src/compiler/turboshaft/branch-elimination-reducer.h b/src/compiler/turboshaft/branch-elimination-reducer.h
index e47c6cef..8041aa12 100644
--- a/src/compiler/turboshaft/branch-elimination-reducer.h
+++ b/src/compiler/turboshaft/branch-elimination-reducer.h
@@ -14,6 +14,7 @@
 #include "src/compiler/turboshaft/index.h"
 #include "src/compiler/turboshaft/layered-hash-map.h"
 #include "src/compiler/turboshaft/operations.h"
+#include "src/compiler/turboshaft/opmasks.h"
 #include "src/utils/utils.h"
 
 namespace v8::internal::compiler::turboshaft {
@@ -472,6 +473,21 @@ class BranchEliminationReducer : public Next {
 
     std::optional<KnownCondition> condition_value =
         known_conditions_.Get(condition);
+    if (!condition_value.has_value()) {
+      V<Word32> value;
+      uint32_t mask;
+      if (MatchWord32Mask(condition, &value, &mask)) {
+        std::optional<uint32_t> known_zero_mask = known_zero_masks_.Get(value);
+        if (known_zero_mask.has_value() && (mask & ~*known_zero_mask) == 0) {
+          condition_value = KnownCondition::Zero();
+        } else if (!negated && !known_zero_mask.has_value()) {
+          // On the continuation of DeoptimizeIf(value & mask), all of the
+          // masked bits are zero. Keep the first fact for each SSA value;
+          // LayeredHashMap does not support updating existing keys.
+          known_zero_masks_.InsertNewKey(value, mask);
+        }
+      }
+    }
     if (!condition_value.has_value()) {
       known_conditions_.InsertNewKey(condition, negated
                                                     ? KnownCondition::NonZero()
@@ -523,6 +539,21 @@ class BranchEliminationReducer : public Next {
 #endif  // V8_ENABLE_WEBASSEMBLY
 
  private:
+  bool MatchWord32Mask(V<Word32> condition, V<Word32>* value, uint32_t* mask) {
+    const WordBinopOp* bitwise_and =
+        __ Get(condition).template TryCast<Opmask::kWord32BitwiseAnd>();
+    if (bitwise_and == nullptr) return false;
+    if (__ matcher().MatchIntegralWord32Constant(bitwise_and->right(), mask)) {
+      *value = bitwise_and->left<Word32>();
+      return true;
+    }
+    if (__ matcher().MatchIntegralWord32Constant(bitwise_and->left(), mask)) {
+      *value = bitwise_and->right<Word32>();
+      return true;
+    }
+    return false;
+  }
+
   // Resets {known_conditions_} and {dominator_path_} up to the 1st dominator of
   // {block} that they contain.
   void ResetToBlock(Block* block) {
@@ -545,11 +576,13 @@ class BranchEliminationReducer : public Next {
   // Removes the latest entry in {known_conditions_} and {dominator_path_}.
   void ClearCurrentEntries() {
     known_conditions_.DropLastLayer();
+    known_zero_masks_.DropLastLayer();
     dominator_path_.pop_back();
   }
 
   void StartLayer(Block* block) {
     known_conditions_.StartLayer();
+    known_zero_masks_.StartLayer();
     dominator_path_.push_back(block);
   }
 
@@ -607,6 +640,9 @@ class BranchEliminationReducer : public Next {
     // order).
     for (Block* block : base::Reversed(missing_blocks)) {
       StartLayer(block);
+      // Guard-derived zero masks are not replayed. Forgetting these facts can
+      // miss an optimization, but avoids inspecting every operation in a
+      // predecessor that is replayed after block cloning.
 
       if (block->IsBranchTarget()) {
         const Operation& op =
@@ -756,6 +792,11 @@ class BranchEliminationReducer : public Next {
   ZoneVector<Block*> dominator_path_{__ phase_zone()};
   LayeredHashMap<V<Word32>, KnownCondition> known_conditions_{
       __ phase_zone(), __ input_graph().DominatorTreeDepth() * 2};
+  // These facts have the same dominator scope as {known_conditions_}. A loop
+  // phi is a distinct SSA value from its input, so a preheader guard does not
+  // imply anything about subsequent values of the induction variable.
+  LayeredHashMap<V<Word32>, uint32_t> known_zero_masks_{
+      __ phase_zone(), __ input_graph().DominatorTreeDepth() * 2};
 };
 
