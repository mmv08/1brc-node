Subject: [PATCH 4/4] [test] Preserve the merge in mask-scope regression

Prevent valid return-block cloning from eliminating the merge under test. Use unrelated false-arm mask bits so the merged guard is semantically necessary on that path.

TAG=agy
CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 .../compiler/turboshaft/control-flow-unittest.cc         | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/test/unittests/compiler/turboshaft/control-flow-unittest.cc b/test/unittests/compiler/turboshaft/control-flow-unittest.cc
index 22edb4ea..083d6244 100644
--- a/test/unittests/compiler/turboshaft/control-flow-unittest.cc
+++ b/test/unittests/compiler/turboshaft/control-flow-unittest.cc
@@ -269,16 +269,21 @@ TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskDiamond) {
       __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0xf), frame_state,
                       DeoptimizeReason::kLostPrecision, FeedbackSource{});
     } ELSE {
-      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x3), frame_state,
+      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0xc), frame_state,
                       DeoptimizeReason::kLostPrecision, FeedbackSource{});
     }
     __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x1), frame_state,
                     DeoptimizeReason::kLostPrecision, FeedbackSource{});
-    __ Return(value);
+    // Keep this merge from being cloned into the arms, where removing the
+    // final guard in the true arm would be valid.
+    V<Word32> result = value;
+    for (int i = 0; i < 64; ++i) result = __ Word32Add(result, value);
+    __ Return(result);
   });
 
   test.Run<BranchEliminationReducer>();
   EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 3u);
+  EXPECT_EQ(test.CountOp(Opcode::kReturn), 1u);
 }
 
 // Cloning the first merge changes visitation order. A zero-mask fact from
