diff --git a/test/mjsunit/turboshaft/deoptimize-if-zero-mask.js b/test/mjsunit/turboshaft/deoptimize-if-zero-mask.js
new file mode 100644
index 00000000..cb03a7ce
--- /dev/null
+++ b/test/mjsunit/turboshaft/deoptimize-if-zero-mask.js
@@ -0,0 +1,67 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax
+
+// These semantic tests preserve the behavior of the implicit divisibility
+// guards used for integer array indices. The graph tests check that redundant
+// guards are removed; these tests also pass without that optimization.
+const values = new Float64Array(20);
+for (let i = 0; i < values.length; ++i) values[i] = i + 0.25;
+
+(function SameValue() {
+  function read(index) {
+    return values[index / 8] + values[index / 4];
+  }
+  %PrepareFunctionForOptimization(read);
+  assertEquals(3.5, read(8));
+  assertEquals(6.5, read(16));
+  %OptimizeFunctionOnNextCall(read);
+  assertEquals(9.5, read(24));
+  assertOptimized(read);
+  assertEquals(0.5, read(0));
+  assertEquals(0.5, read(-0));
+  // The first guard must still deopt for an index not divisible by eight.
+  assertEquals(NaN, read(12));
+  assertEquals(NaN, read(-8));
+  assertEquals(NaN, read(8.5));
+  assertEquals(NaN, read(0x100000008));
+})();
+
+(function ConditionalGuard() {
+  function read(index, include_first) {
+    let result = 0;
+    if (include_first) result = values[index / 8];
+    return result + values[index / 4];
+  }
+  %PrepareFunctionForOptimization(read);
+  assertEquals(6.5, read(16, true));
+  assertEquals(4.25, read(16, false));
+  %OptimizeFunctionOnNextCall(read);
+  assertEquals(6.5, read(16, true));
+  assertOptimized(read);
+  // A guard in the skipped arm cannot constrain the merged index.
+  assertEquals(1.25, read(4, false));
+  assertEquals(NaN, read(2, false));
+})();
+
+(function LoopAndOsr() {
+  function sum(start, step, request_osr) {
+    let result = 0;
+    for (let index = start; index < 48; index += step) {
+      result += values[index / 8] + values[index / 4];
+      if (request_osr && index === start) %OptimizeOsr();
+    }
+    return result;
+  }
+  %PrepareFunctionForOptimization(sum);
+  assertEquals(48, sum(0, 8, false));
+  assertEquals(48, sum(0, 8, false));
+  assertEquals(48, sum(0, 8, true));
+  %OptimizeFunctionOnNextCall(sum);
+  assertEquals(48, sum(0, 8, false));
+  assertOptimized(sum);
+  // A guard for one induction value cannot constrain later iterations.
+  assertEquals(NaN, sum(0, 4, false));
+})();
diff --git a/test/unittests/compiler/turboshaft/control-flow-unittest.cc b/test/unittests/compiler/turboshaft/control-flow-unittest.cc
index 1d23775d..5a7a6250 100644
--- a/test/unittests/compiler/turboshaft/control-flow-unittest.cc
+++ b/test/unittests/compiler/turboshaft/control-flow-unittest.cc
@@ -112,6 +112,229 @@ TEST_F(ControlFlowTest, BranchElimination) {
             static_cast<size_t>(kSize * 2 + kMaxOtherBlocksCount));
 }
 
+// A successful deopt guard establishes zero bits for the exact Word32 SSA
+// value. Neither the bit positions nor the operand order are special.
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskSubset) {
+  struct Masks {
+    uint32_t known;
+    uint32_t subset;
+  };
+  for (Masks masks : {Masks{0x7, 0x3}, Masks{0x5500, 0x4100},
+                      Masks{0x80000005, 0x80000000}}) {
+    for (bool constant_on_left : {false, true}) {
+      const RegisterRepresentation reps[] = {RegisterRepresentation::Word32()};
+      auto test = CreateFromGraph(base::VectorOf(reps), [&](auto& Asm) {
+        V<Word32> value = Asm.template GetParameter<Word32>(0);
+        V<EagerFrameState> frame_state = Asm.BuildFrameState();
+        V<Word32> known_mask = __ Word32Constant(masks.known);
+        V<Word32> subset_mask = __ Word32Constant(masks.subset);
+        V<Word32> first = constant_on_left
+                              ? __ Word32BitwiseAnd(known_mask, value)
+                              : __ Word32BitwiseAnd(value, known_mask);
+        V<Word32> second = constant_on_left
+                               ? __ Word32BitwiseAnd(subset_mask, value)
+                               : __ Word32BitwiseAnd(value, subset_mask);
+        __ DeoptimizeIf(first, frame_state, DeoptimizeReason::kLostPrecision,
+                        FeedbackSource{});
+        __ DeoptimizeIf(second, frame_state, DeoptimizeReason::kLostPrecision,
+                        FeedbackSource{});
+        __ Return(value);
+      });
+
+      test.Run<BranchEliminationReducer>();
+      EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 1u);
+      EXPECT_EQ(test.CountOp(Opcode::kDeoptimize), 0u);
+    }
+  }
+}
+
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskContradiction) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x55), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    __ DeoptimizeIfNot(__ Word32BitwiseAnd(value, 0x41), frame_state,
+                       DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    __ Return(value);
+  });
+
+  test.Run<BranchEliminationReducer>();
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 1u);
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimize), 1u);
+  EXPECT_EQ(test.CountOp(Opcode::kReturn), 0u);
+}
+
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskUnrelated) {
+  struct Guards {
+    uint32_t known;
+    uint32_t other;
+    bool first_negated;
+    bool different_value;
+  };
+  for (Guards guards :
+       {Guards{0x3, 0x7, false, false}, Guards{0x3, 0xc, false, false},
+        Guards{0x7, 0x3, true, false}, Guards{0x7, 0x3, false, true}}) {
+    const RegisterRepresentation reps[] = {RegisterRepresentation::Word32(),
+                                           RegisterRepresentation::Word32()};
+    auto test = CreateFromGraph(base::VectorOf(reps), [&](auto& Asm) {
+      V<Word32> value = Asm.template GetParameter<Word32>(0);
+      V<Word32> other =
+          guards.different_value ? Asm.template GetParameter<Word32>(1) : value;
+      V<EagerFrameState> frame_state = Asm.BuildFrameState();
+      V<Word32> first = __ Word32BitwiseAnd(value, guards.known);
+      if (guards.first_negated) {
+        __ DeoptimizeIfNot(first, frame_state, DeoptimizeReason::kLostPrecision,
+                           FeedbackSource{});
+      } else {
+        __ DeoptimizeIf(first, frame_state, DeoptimizeReason::kLostPrecision,
+                        FeedbackSource{});
+      }
+      __ DeoptimizeIf(__ Word32BitwiseAnd(other, guards.other), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+      __ Return(value);
+    });
+
+    test.Run<BranchEliminationReducer>();
+    EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 2u);
+    EXPECT_EQ(test.CountOp(Opcode::kDeoptimize), 0u);
+  }
+}
+
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskVariable) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32(),
+                                         RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<Word32> mask = Asm.template GetParameter<Word32>(1);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, mask), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 3), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    __ Return(value);
+  });
+
+  test.Run<BranchEliminationReducer>();
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 2u);
+}
+
+// A guard from one arm does not dominate the other arm or the merge.
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskDiamond) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32(),
+                                         RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<Word32> condition = Asm.template GetParameter<Word32>(1);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    IF (condition) {
+      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0xf), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    } ELSE {
+      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x3), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    }
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x1), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    __ Return(value);
+  });
+
+  test.Run<BranchEliminationReducer>();
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 3u);
+}
+
+// Cloning the first merge changes visitation order. A zero-mask fact from
+// the true arm must not be replayed into the false arm of the second diamond.
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskClonedDiamond) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32(),
+                                         RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<Word32> condition = Asm.template GetParameter<Word32>(1);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    ScopedVar<Word32, TestInstance::assembler_t> selected(&Asm, 0);
+    IF (condition) {
+      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0xf), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+      selected = 1;
+    }
+    IF (selected) {
+      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x1), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    } ELSE {
+      V<Word32> false_condition =
+          Asm.Capture(__ Word32BitwiseAnd(value, 0x3), "false_condition");
+      __ DeoptimizeIf(false_condition, frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    }
+    __ Return(value);
+  });
+
+  test.Run<BranchEliminationReducer, MachineOptimizationReducer>();
+  // The branch on the selected constant was folded through block cloning.
+  EXPECT_EQ(test.CountOp(Opcode::kBranch), 1u);
+  bool found_false_guard = false;
+  for (const Operation& op : test.graph().AllOperations()) {
+    if (const DeoptimizeIfOp* guard = op.TryCast<DeoptimizeIfOp>()) {
+      found_false_guard |=
+          test.GetCapture("false_condition").Is(guard->condition());
+    }
+  }
+  EXPECT_TRUE(found_false_guard);
+}
+
+// The loop can exit before the guarded body executes. Its facts must not
+// escape to the exit, even though the guarded SSA value is loop invariant.
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskLoopExit) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    LoopLabel<Word32> loop(&Asm);
+    Label<> end(&Asm);
+    GOTO(loop, value);
+    BIND_LOOP(loop, iter) {
+      GOTO_IF(__ Word32Equal(iter, 42), end);
+      __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0xf), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+      GOTO(loop, __ Word32Add(iter, 1));
+    }
+    BIND(end);
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x3), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    __ Return(value);
+  });
+
+  test.Run<BranchEliminationReducer>();
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 2u);
+}
+
+// A zero-mask fact about the initial value does not constrain the loop phi.
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskLoopPhi) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0xf), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    LoopLabel<Word32> loop(&Asm);
+    Label<> end(&Asm);
+    GOTO(loop, value);
+    BIND_LOOP(loop, iter) {
+      GOTO_IF(__ Word32Equal(iter, 42), end);
+      __ DeoptimizeIf(__ Word32BitwiseAnd(iter, 0x3), frame_state,
+                      DeoptimizeReason::kLostPrecision, FeedbackSource{});
+      GOTO(loop, __ Word32Add(iter, 1));
+    }
+    BIND(end);
+    __ Return(value);
+  });
+
+  test.Run<BranchEliminationReducer>();
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 2u);
+}
+
 // When the block following a loop header has a single predecessor and contains
 // Phis with a single input, loop peeling should be careful not to think that
 // these phis are loop phis.
-- 
