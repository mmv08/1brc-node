+++ b/test/unittests/compiler/turboshaft/control-flow-unittest.cc
@@ -220,6 +220,43 @@ TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskVariable) {
   EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 2u);
 }
 
+// A guard before a diamond dominates its merge, even after facts from each
+// arm have been dropped. Keep the merge too large to clone into either arm.
+TEST_F(ControlFlowTest, DeoptimizeIfZeroMaskDominatesMerge) {
+  const RegisterRepresentation reps[] = {RegisterRepresentation::Word32(),
+                                         RegisterRepresentation::Word32()};
+  auto test = CreateFromGraph(base::VectorOf(reps), [](auto& Asm) {
+    V<Word32> value = Asm.template GetParameter<Word32>(0);
+    V<Word32> condition = Asm.template GetParameter<Word32>(1);
+    V<EagerFrameState> frame_state = Asm.BuildFrameState();
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x55), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    ScopedVar<Word32, TestInstance::assembler_t> selected(&Asm, value);
+    IF (condition) {
+      selected = __ Word32Add(value, 1);
+    } ELSE {
+      selected = __ Word32Add(value, 2);
+    }
+    V<Word32> result = selected;
+    Asm.Capture(result, "merge_phi");
+    __ DeoptimizeIf(__ Word32BitwiseAnd(value, 0x41), frame_state,
+                    DeoptimizeReason::kLostPrecision, FeedbackSource{});
+    for (int i = 0; i < 64; ++i) result = __ Word32Add(result, value);
+    __ Return(result);
+  });
+
+  test.Run<BranchEliminationReducer>();
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 1u);
+  EXPECT_EQ(test.CountOp(Opcode::kBranch), 1u);
+  EXPECT_EQ(test.CountOp(Opcode::kPhi), 1u);
+  const auto& phi_capture = test.GetCapture("merge_phi");
+  ASSERT_EQ(phi_capture.generated_output.size(), 1u);
+  OpIndex phi_index = *phi_capture.generated_output.begin();
+  const Block& merge = test.graph().Get(test.graph().BlockOf(phi_index));
+  EXPECT_EQ(merge.PredecessorCount(), 2u);
+  EXPECT_EQ(merge.GetDominator(), &test.graph().StartBlock());
+}
+
 // A guard from one arm does not dominate the other arm or the merge.
