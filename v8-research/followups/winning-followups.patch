From 2c9b411210768f481099b1bca0aa3f4861959ee1 Mon Sep 17 00:00:00 2001
From: Mikhail Mikheev <16622558+mmv08@users.noreply.github.com>
Date: Wed, 21 Oct 2026 10:02:21 +0000
Subject: [PATCH 3/5] [compiler] Check retained terminal inputs transitively

Reject indirect dependencies on the original loop or its shared exits before copying a terminal path. Bound external-input validation and treat enclosing-loop headers as invariant within an execution of the nested loop.

TAG=agy

CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 src/compiler/loop-peeling.cc                  | 48 ++++++++++
 .../compiler/loop-peeling-unittest.cc         | 96 +++++++++++++++++++
 2 files changed, 144 insertions(+)

diff --git a/src/compiler/loop-peeling.cc b/src/compiler/loop-peeling.cc
index 7720021e..b573b588 100644
--- a/src/compiler/loop-peeling.cc
+++ b/src/compiler/loop-peeling.cc
@@ -180,6 +180,38 @@ bool LoopPeeler::CollectTerminatingNodes(LoopTree::Loop* loop,
     }
   }
 
+  // Retained external inputs must not depend indirectly on this loop's exits
+  // either. Enclosing loop headers are invariant during one execution of this
+  // loop: their backedges belong to the next enclosing iteration, so do not
+  // follow them back into this loop. Other external dependencies are checked
+  // transitively, with a separate bound on the validation work.
+  auto is_enclosing_header = [&](Node* node) {
+    Node* header = node;
+    if (NodeProperties::IsPhi(node)) {
+      header = NodeProperties::GetControlInput(node);
+    }
+    if (header->opcode() != IrOpcode::kLoop) return false;
+    LoopTree::Loop* header_loop = loop_tree_->ContainingLoop(header);
+    for (LoopTree::Loop* parent = loop->parent(); parent != nullptr;
+         parent = parent->parent()) {
+      if (header_loop == parent) return true;
+    }
+    return false;
+  };
+  ZoneUnorderedSet<Node*> checked_inputs(tmp_zone_);
+  NodeVector external_inputs(tmp_zone_);
+  auto enqueue_external_input = [&](Node* node) {
+    if (is_own_exit(node)) return false;
+    if (is_enclosing_header(node) ||
+        checked_inputs.find(node) != checked_inputs.end()) {
+      return true;
+    }
+    if (external_inputs.size() >= kMaxPeeledNodes) return false;
+    checked_inputs.insert(node);
+    external_inputs.push_back(node);
+    return true;
+  };
+
   // In particular, reject a merge with a path originating outside this loop:
   // copying that merge would execute its other predecessor twice. All
   // control inputs must belong to the body or the collected terminal region.
@@ -189,6 +221,11 @@ bool LoopPeeler::CollectTerminatingNodes(LoopTree::Loop* loop,
     // reference such a shared exit. Child-loop exits are part of the body.
     for (Node* input : node->inputs()) {
       if (is_own_exit(input)) return false;
+      if (!loop_tree_->Contains(loop, input) &&
+          visited.find(input) == visited.end() &&
+          !enqueue_external_input(input)) {
+        return false;
+      }
     }
     for (int i = 0; i < node->op()->ControlInputCount(); ++i) {
       Node* control = NodeProperties::GetControlInput(node, i);
@@ -198,6 +235,17 @@ bool LoopPeeler::CollectTerminatingNodes(LoopTree::Loop* loop,
       }
     }
   }
+  for (size_t i = 0; i < external_inputs.size(); ++i) {
+    for (Node* input : external_inputs[i]->inputs()) {
+      // An uncopied predecessor cannot retain an input tied to the original
+      // iteration, even if that input itself would be mapped when copying.
+      if (loop_tree_->Contains(loop, input) ||
+          visited.find(input) != visited.end() ||
+          !enqueue_external_input(input)) {
+        return false;
+      }
+    }
+  }
   return true;
 }
 
