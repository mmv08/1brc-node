From fcc581786fd0b32e8136e6eb8ea3f6967c1c30ca Mon Sep 17 00:00:00 2001
From: Mikhail Mikheev <16622558+mmv08@users.noreply.github.com>
Date: Wed, 21 Oct 2026 09:42:36 +0000
Subject: [PATCH 5/5] [turboshaft] Budget branch cloning by executable
 operations

Separate the small-block code budget from Phi substitutions and
FrameState metadata. Count operations only when the cheap storage bound
is too conservative, and cap total storage at twice the code budget to
bound scanning and metadata growth.

Keep the variable budget and Wasm deoptimization restriction. Add graph
coverage for accepted metadata, excessive code and state, and Wasm.

TAG=agy
CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 .../turboshaft/branch-elimination-reducer.h   | 30 +++---
 .../turboshaft/control-flow-unittest.cc       | 97 ++++++++++++++++++-
 2 files changed, 112 insertions(+), 15 deletions(-)

diff --git a/src/compiler/turboshaft/branch-elimination-reducer.h b/src/compiler/turboshaft/branch-elimination-reducer.h
index c19ee2ef..419642be 100644
--- a/src/compiler/turboshaft/branch-elimination-reducer.h
+++ b/src/compiler/turboshaft/branch-elimination-reducer.h
@@ -353,37 +353,39 @@ class BranchEliminationReducer : public Next {
       goto no_change;
     }
 
-    // Maximum size up to which we allow cloning a block. Cloning too large
-    // blocks will lead to increasing the size of the graph too much, which will
-    // lead to slower compile time, and larger generated code.
-    // TODO(dmercadier): we might want to exclude Phis from this, since they are
-    // typically removed when we clone a block. However, computing the number of
-    // operations in a block excluding Phis is more costly (because we'd have to
-    // iterate all of the operations one by one).
-    // TODO(dmercadier): this "13" was selected fairly arbitrarily (= it sounded
-    // reasonable). It could be useful to run a few benchmarks to see if we can
-    // find a more optimal number.
+    // Bound both generated code and compilation work. Phis are substituted
+    // when cloning an incoming edge, and FrameStates emit no instructions, so
+    // exclude them from the code budget. A separate bound on the total storage
+    // limits metadata growth and the cost of counting operations.
     static constexpr int kMaxOpCountForCloning = 13;
+    static constexpr int kMaxOpCountUpperBoundForCloning =
+        2 * kMaxOpCountForCloning;
 
     const Operation& last_op =
         destination_origin->LastOperation(__ input_graph());
 
-    if (destination_origin->OpCountUpperBound() > kMaxOpCountForCloning) {
+    const int op_count_upper_bound = destination_origin->OpCountUpperBound();
+    if (op_count_upper_bound > kMaxOpCountUpperBoundForCloning) {
       goto no_change;
     }
 
-    if (!__ CanCreateNVariables(destination_origin->OpCountUpperBound())) {
+    if (!__ CanCreateNVariables(op_count_upper_bound)) {
       goto no_change;
     }
 
-    if (__ data()->is_wasm()) {
+    if (op_count_upper_bound > kMaxOpCountForCloning || __ data()->is_wasm()) {
+      int op_count = 0;
       // Wasm cannot handle it if too many deoptimization exits are created
       // (kTooManyDeoptimizationBailouts in the CodeGenerator). In Wasm,
       // DeoptimizeIfOps are rare and cloning them is probably not worth the
       // metadata overhead.
       for (const Operation& op :
            __ input_graph().operations(*destination_origin)) {
-        if (op.Is<DeoptimizeIfOp>()) {
+        if (__ data()->is_wasm() && op.Is<DeoptimizeIfOp>()) {
+          goto no_change;
+        }
+        if (!op.Is<PhiOp>() && !op.Is<FrameStateOp>() &&
+            ++op_count > kMaxOpCountForCloning) {
           goto no_change;
         }
       }
