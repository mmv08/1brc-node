new file mode 100644
index 00000000..331c9bb2
--- /dev/null
+++ b/test/mjsunit/compiler/terminal-throw-loop-peeling.js
@@ -0,0 +1,59 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax --turbofan
+
+const ordinary = new ArrayBuffer(8);
+const shared = Reflect.construct(SharedArrayBuffer, [8], ArrayBuffer);
+
+// Both receiver maps enter the feedback, so the shared buffer reaches the
+// getter's terminal throwing path rather than an unexpected-map deopt.
+(function FirstAndLaterIteration() {
+  function sumLengths(buffers) {
+    let total = 0;
+    for (let i = 0; i < buffers.length; ++i) {
+      total += buffers[i].byteLength;
+    }
+    return total;
+  }
+
+  %PrepareFunctionForOptimization(sumLengths);
+  assertEquals(16, sumLengths([ordinary, ordinary]));
+  assertEquals(0, sumLengths([]));
+  assertThrows(() => sumLengths([shared]), TypeError);
+  assertThrows(() => sumLengths([ordinary, shared]), TypeError);
+  %OptimizeFunctionOnNextCall(sumLengths);
+  assertEquals(16, sumLengths([ordinary, ordinary]));
+  assertOptimized(sumLengths);
+  assertEquals(0, sumLengths([]));
+  assertThrows(() => sumLengths([shared]), TypeError);
+  assertThrows(() => sumLengths([ordinary, ordinary, shared]), TypeError);
+  assertEquals(24, sumLengths([ordinary, ordinary, ordinary]));
+})();
+
+(function NestedIterations() {
+  function sumLengths(rows) {
+    let total = 0;
+    for (let row = 0; row < rows.length; ++row) {
+      const buffers = rows[row];
+      for (let column = 0; column < buffers.length; ++column) {
+        total += buffers[column].byteLength;
+      }
+    }
+    return total;
+  }
+
+  %PrepareFunctionForOptimization(sumLengths);
+  assertEquals(24, sumLengths([[ordinary], [ordinary, ordinary]]));
+  assertEquals(0, sumLengths([[], []]));
+  assertThrows(() => sumLengths([[shared]]), TypeError);
+  assertThrows(() => sumLengths([[ordinary], [ordinary, shared]]), TypeError);
+  %OptimizeFunctionOnNextCall(sumLengths);
+  assertEquals(24, sumLengths([[ordinary], [ordinary, ordinary]]));
+  assertOptimized(sumLengths);
+  assertEquals(0, sumLengths([[], []]));
+  assertThrows(() => sumLengths([[shared]]), TypeError);
+  assertThrows(() => sumLengths([[ordinary], [ordinary, shared]]), TypeError);
+  assertEquals(16, sumLengths([[ordinary], [], [ordinary]]));
+})();
