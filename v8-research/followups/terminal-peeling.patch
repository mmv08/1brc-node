   PeeledIterationImpl* iter = tmp_zone_->New<PeeledIterationImpl>(tmp_zone_);
-  uint32_t estimated_peeled_size = 5 + loop->TotalSize() * 2;
+  uint32_t estimated_peeled_size =
+      5 +
+      (loop->TotalSize() + static_cast<uint32_t>(terminating_nodes.size())) * 2;
   NodeCopier copier(graph_, estimated_peeled_size, &iter->node_pairs_, 1);
 
   Node* dead = graph_->NewNode(common_->Dead());
@@ -139,9 +213,21 @@ PeeledIteration* LoopPeeler::Peel(LoopTree::Loop* loop) {
     copier.Insert(node, node->InputAt(kAssumedLoopEntryIndex));
   }
 
-  // Copy all the nodes of loop body for the peeled iteration.
-  copier.CopyNodes(graph_, tmp_zone_, dead, loop_tree_->BodyNodes(loop),
-                   source_positions_, node_origins_);
+  // Copy the terminal paths as well, so their effects and frame states refer
+  // to the peeled iteration's values rather than the original loop's phis.
+  NodeRange body = loop_tree_->BodyNodes(loop);
+  NodeVector nodes_to_copy(body.begin(), body.end(), tmp_zone_);
+  nodes_to_copy.insert(nodes_to_copy.end(), terminating_nodes.begin(),
+                       terminating_nodes.end());
+  copier.CopyNodes(
+      graph_, tmp_zone_, dead,
+      base::make_iterator_range(nodes_to_copy.begin(), nodes_to_copy.end()),
+      source_positions_, node_origins_);
+  for (Node* node : terminating_nodes) {
+    if (node->opcode() == IrOpcode::kThrow) {
+      NodeProperties::MergeControlToEnd(graph_, common_, copier.map(node));
+    }
+  }
 
   //============================================================================
   // Replace the entry to the loop with the output of the peeled iteration.
