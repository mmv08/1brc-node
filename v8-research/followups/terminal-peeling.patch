+TEST_F(LoopPeelingTest, TerminalThrowCopiesEffectsAndFrameState) {
+  Node* p0 = Parameter(0);
+  While w = NewWhile(p0);
+  Counter counter = NewCounter(&w, 0, 1);
+  Node* effect =
+      graph()->NewNode(common()->EffectPhi(2), start(), start(), w.loop);
+  Node* load = graph()->NewNode(machine()->Load(MachineType::Int32()), p0,
+                                Int32Constant(0), effect, w.if_true);
+  effect->ReplaceInput(1, load);
+  Branch side = NewBranch(counter.phi, w.if_true);
+  w.loop->ReplaceInput(1, side.if_false);
+  Node* terminal =
+      NewTerminalThrow(counter.phi, counter.add, load, side.if_true);
+  Node* call = NodeProperties::GetControlInput(terminal);
+  Node* frame_state = NodeProperties::GetFrameStateInput(call);
+  Node* locals = NodeProperties::GetValueInput(frame_state, 1);
+  Node* result = InsertReturn(counter.exit_marker, start(), w.exit);
+  graph()->SetEnd(graph()->NewNode(common()->End(2), result, terminal));
+
+  LoopTree* tree = GetLoopTree();
+  LoopTree::Loop* loop = tree->outer_loops()[0];
+  EXPECT_FALSE(LoopFinder::HasMarkedExits(tree, loop));
+  LoopPeeler peeler(graph(), common(), tree, zone(), source_positions(),
+                    node_origins());
+  PeeledIteration* peeled = Peel(peeler, loop);
+
+  Node* copied_call = ExpectPeeled(call, peeled);
+  Node* copied_frame = ExpectPeeled(frame_state, peeled);
+  Node* copied_locals = ExpectPeeled(locals, peeled);
+  EXPECT_EQ(counter.base, NodeProperties::GetValueInput(copied_call, 0));
+  EXPECT_EQ(peeled->map(load), NodeProperties::GetEffectInput(copied_call));
+  EXPECT_EQ(peeled->map(side.if_true),
+            NodeProperties::GetControlInput(copied_call));
+  EXPECT_EQ(copied_frame, NodeProperties::GetFrameStateInput(copied_call));
+  EXPECT_EQ(copied_locals, NodeProperties::GetValueInput(copied_frame, 1));
+  EXPECT_EQ(counter.base, copied_locals->InputAt(0));
+  EXPECT_EQ(peeled->map(counter.add), copied_locals->InputAt(1));
+  EXPECT_EQ(counter.phi, NodeProperties::GetValueInput(call, 0));
+  EXPECT_EQ(load, NodeProperties::GetEffectInput(call));
+  EXPECT_EQ(3, end()->InputCount());
+  EXPECT_EQ(terminal, end()->InputAt(1));
+  EXPECT_EQ(ExpectPeeled(terminal, peeled), end()->InputAt(2));
+}
+
