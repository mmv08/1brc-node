+  test.Run<BranchEliminationReducer, MachineOptimizationReducer>();
+
+  EXPECT_EQ(test.CountOp(Opcode::kBranch), 1u);
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 2u);
+  EXPECT_EQ(test.CountOp(Opcode::kFrameState), 2u);
+}
+
+TEST_F(ControlFlowTest, BranchEliminationCloningCodeBudget) {
+  auto test = CreateConstantPhiWithFrameState(14, 1);
+
+  test.Run<BranchEliminationReducer, MachineOptimizationReducer>();
+
+  EXPECT_EQ(test.CountOp(Opcode::kBranch), 2u);
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 1u);
+}
+
+TEST_F(ControlFlowTest, BranchEliminationCloningStorageBudget) {
+  auto test = CreateConstantPhiWithFrameState(0, 120);
+
+  test.Run<BranchEliminationReducer, MachineOptimizationReducer>();
+
+  EXPECT_EQ(test.CountOp(Opcode::kBranch), 2u);
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 1u);
+}
+
+#if V8_ENABLE_WEBASSEMBLY
+TEST_F(ControlFlowTest, BranchEliminationPreservesWasmDeoptRestriction) {
+  auto test = CreateConstantPhiWithFrameState(7, 12, true);
+
+  test.Run<BranchEliminationReducer, MachineOptimizationReducer>();
+
+  EXPECT_EQ(test.CountOp(Opcode::kBranch), 2u);
+  EXPECT_EQ(test.CountOp(Opcode::kDeoptimizeIf), 1u);
+}
+#endif
