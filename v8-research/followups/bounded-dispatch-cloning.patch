@@ -19,7 +19,63 @@ namespace v8::internal::compiler::turboshaft {
 
 #include "src/compiler/turboshaft/define-assembler-macros.inc"
 
-class ControlFlowTest : public ReducerTest {};
+class ControlFlowTest : public ReducerTest {
+ public:
+  TestInstance CreateConstantPhiWithFrameState(int arithmetic_count,
+                                               int local_count,
+                                               bool is_wasm = false) {
+    std::initializer_list<RegisterRepresentation> reps{
+        RegisterRepresentation::Word32(), RegisterRepresentation::Word32()};
+    return CreateFromGraph(
+        base::VectorOf(reps),
+        [&](auto& Asm) {
+          V<Word32> cond = Asm.template GetParameter<Word32>(0);
+          V<Word32> unknown = Asm.template GetParameter<Word32>(1);
+          V<Word32> first = __ Word32Constant(7);
+          V<Word32> second = __ Word32Constant(11);
+          V<Smi> closure = __ SmiConstant(Smi::FromInt(0));
+          Block *left = __ NewBlock(), *right = __ NewBlock();
+          Block* merge = __ NewBlock();
+          __ Branch(cond, left, right);
+          __ Bind(left);
+          __ Goto(merge);
+          __ Bind(right);
+          __ Goto(merge);
+          __ Bind(merge);
+          V<Word32> phi =
+              __ Phi({first, second}, RegisterRepresentation::Word32());
+          V<Word32> value = phi;
+          for (int i = 0; i < arithmetic_count; ++i) {
+            value = __ Word32Add(value, unknown);
+          }
+          FrameStateData::Builder builder;
+          builder.AddInput(MachineType::AnyTagged(), closure);
+          for (int i = 0; i < local_count; ++i) {
+            builder.AddInput(MachineType::Int32(), value);
+          }
+          auto* function_info =
+              Asm.zone()->template New<FrameStateFunctionInfo>(
+                  FrameStateType::kUnoptimizedFunction, 0, 0, local_count,
+                  Handle<SharedFunctionInfo>{}, Handle<BytecodeArray>{});
+          FrameStateInfo frame_state_info(BytecodeOffset(0),
+                                          OutputFrameStateCombine::Ignore(),
+                                          function_info);
+          V<EagerFrameState> frame_state =
+              __ template FrameState<EagerFrameState>(
+                  builder.Inputs(), builder.inlined(),
+                  builder.AllocateFrameStateData(frame_state_info, Asm.zone()));
+          __ DeoptimizeIf(unknown, frame_state, DeoptimizeReason::kOverflow,
+                          {});
+          Block *matched = __ NewBlock(), *other = __ NewBlock();
+          __ Branch(__ Word32Equal(phi, first), matched, other);
+          __ Bind(matched);
+          __ Return(value);
+          __ Bind(other);
+          __ Return(value);
+        },
+        is_wasm);
+  }
+};
 
 // This test creates a chain of empty blocks linked by Gotos. CopyingPhase
 // should automatically inline them, leading to the graph containing a single
@@ -215,6 +271,45 @@ TEST_F(ControlFlowTest, BranchEliminationConstantExpressionWithoutPhi) {
   EXPECT_EQ(test.CountOp(Opcode::kStore), 1u);
 }
 
