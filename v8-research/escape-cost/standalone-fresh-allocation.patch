+TEST_F(LoadEliminationTest, FinishedAllocationInvalidatesRenamedObject) {
+  FieldAccess access = {kTaggedBase,      kTaggedSize, MaybeHandle<Name>(),
+                        OptionalMapRef(), Type::Any(), MachineType::AnyTagged(),
+                        kNoWriteBarrier};
+  FieldAccess store_access = access;
+  store_access.offset = 2048 * kTaggedSize;
+  Node* start = graph()->start();
+  Node* value = Parameter(Type::Any(), 0);
+  Node* object = graph()->NewNode(
+      simplified()->Allocate(Type::Any(), AllocationType::kYoung),
+      jsgraph()->ConstantNoHole(16), start, start);
+  Node* finished = graph()->NewNode(common()->FinishRegion(), object, object);
+  Node* renamed = graph()->NewNode(common()->TypeGuard(Type::Any()), finished,
+                                   finished, start);
+  Node* load = graph()->NewNode(simplified()->LoadField(access), renamed,
+                                renamed, start);
+  Node* store = graph()->NewNode(simplified()->StoreField(store_access),
+                                 finished, value, load, start);
+  Node* reload =
+      graph()->NewNode(simplified()->LoadField(access), renamed, store, start);
+  StrictMock<MockAdvancedReducerEditor> editor;
+  LoadElimination reducer(&editor, broker(), jsgraph(), zone());
+  for (Node* node : {start, object, finished, renamed, load, store}) {
+    reducer.Reduce(node);
+  }
+  EXPECT_EQ(reload, reducer.Reduce(reload).replacement());
+}
