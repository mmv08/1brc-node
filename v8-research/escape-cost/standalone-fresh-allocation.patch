+TEST_F(LoadEliminationTest, FreshAllocationInvalidationPreservesOtherObjects) {
+  FieldAccess access = {kTaggedBase,      kTaggedSize, MaybeHandle<Name>(),
+                        OptionalMapRef(), Type::Any(), MachineType::AnyTagged(),
+                        kNoWriteBarrier};
+  FieldAccess store_access = access;
+  store_access.offset = 2048 * kTaggedSize;
+  Node* start = graph()->start();
+  Node* value = Parameter(Type::Any(), 0);
+  Node* object_a = graph()->NewNode(
+      simplified()->Allocate(Type::Any(), AllocationType::kYoung),
+      jsgraph()->ConstantNoHole(16), start, start);
+  Node* load_a = graph()->NewNode(simplified()->LoadField(access), object_a,
+                                  object_a, start);
+  Node* object_b = graph()->NewNode(
+      simplified()->Allocate(Type::Any(), AllocationType::kYoung),
+      jsgraph()->ConstantNoHole(16), load_a, start);
+  Node* load_b = graph()->NewNode(simplified()->LoadField(access), object_b,
+                                  object_b, start);
+  // An unsupported offset invalidates without recording the stored value.
+  Node* store = graph()->NewNode(simplified()->StoreField(store_access),
+                                 object_a, value, load_b, start);
+  Node* reload_a =
+      graph()->NewNode(simplified()->LoadField(access), object_a, store, start);
+  Node* reload_b = graph()->NewNode(simplified()->LoadField(access), object_b,
+                                    reload_a, start);
+  Node* original_a = graph()->NewNode(simplified()->LoadField(access), object_a,
+                                      load_b, start);
+  StrictMock<MockAdvancedReducerEditor> editor;
+  LoadElimination reducer(&editor, broker(), jsgraph(), zone());
+  for (Node* node : {start, object_a, load_a, object_b, load_b, store}) {
+    reducer.Reduce(node);
+  }
+  EXPECT_EQ(reload_a, reducer.Reduce(reload_a).replacement());
+  EXPECT_CALL(editor, ReplaceWithValue(reload_b, load_b, reload_a, _));
+  EXPECT_EQ(load_b, reducer.Reduce(reload_b).replacement());
+  // Invalidation must not mutate an earlier effect's persistent state.
+  EXPECT_CALL(editor, ReplaceWithValue(original_a, load_a, load_b, _));
+  EXPECT_EQ(load_a, reducer.Reduce(original_a).replacement());
+}
