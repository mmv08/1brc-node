+TEST_F(LoadEliminationTest, FreshAllocationInvalidationWithAliasingNames) {
+  const char* names[][2] = {{"a", "a"}, {"a", nullptr}, {nullptr, "a"}};
+  auto name = [this](const char* text) -> MaybeHandle<Name> {
+    if (!text) return {};
+    return CanonicalHandle(factory()->InternalizeUtf8String(text));
+  };
+  for (const auto& pair : names) {
+    SCOPED_TRACE(pair[0] ? pair[0] : "<unknown load name>");
+    SCOPED_TRACE(pair[1] ? pair[1] : "<unknown store name>");
+    FieldAccess access = {kTaggedBase,    kTaggedSize,
+                          name(pair[0]),  OptionalMapRef(),
+                          Type::Any(),    MachineType::AnyTagged(),
+                          kNoWriteBarrier};
+    FieldAccess store_access = access;
+    store_access.offset = 2048 * kTaggedSize;
+    store_access.name = name(pair[1]);
+    Node* start = graph()->start();
+    Node* value = Parameter(Type::Any(), 0);
+    Node* object = graph()->NewNode(
+        simplified()->Allocate(Type::Any(), AllocationType::kYoung),
+        jsgraph()->ConstantNoHole(16), start, start);
+    Node* load = graph()->NewNode(simplified()->LoadField(access), object,
+                                  object, start);
+    Node* store = graph()->NewNode(simplified()->StoreField(store_access),
+                                   object, value, load, start);
+    Node* reload =
+        graph()->NewNode(simplified()->LoadField(access), object, store, start);
+    StrictMock<MockAdvancedReducerEditor> editor;
+    LoadElimination reducer(&editor, broker(), jsgraph(), zone());
+    for (Node* node : {start, object, load, store}) reducer.Reduce(node);
+    EXPECT_EQ(reload, reducer.Reduce(reload).replacement());
+  }
+}
