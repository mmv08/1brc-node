+TEST_F(LoadEliminationTest, FreshAllocationDisjointNameDoesNotAllocate) {
+  FieldAccess access = {kTaggedBase,
+                        kTaggedSize,
+                        CanonicalHandle(factory()->InternalizeUtf8String("a")),
+                        OptionalMapRef(),
+                        Type::Any(),
+                        MachineType::AnyTagged(),
+                        kNoWriteBarrier};
+  FieldAccess store_access = access;
+  store_access.offset = 2048 * kTaggedSize;
+  store_access.name = CanonicalHandle(factory()->InternalizeUtf8String("b"));
+  Node* start = graph()->start();
+  Node* value = Parameter(Type::Any(), 0);
+  Node* object = graph()->NewNode(
+      simplified()->Allocate(Type::Any(), AllocationType::kYoung),
+      jsgraph()->ConstantNoHole(16), start, start);
+  Node* load =
+      graph()->NewNode(simplified()->LoadField(access), object, object, start);
+  Node* store = graph()->NewNode(simplified()->StoreField(store_access), object,
+                                 value, load, start);
+  Node* reload =
+      graph()->NewNode(simplified()->LoadField(access), object, store, start);
+  StrictMock<MockAdvancedReducerEditor> editor;
+  LoadElimination reducer(&editor, broker(), jsgraph(), zone());
+  for (Node* node : {start, object, load, store}) reducer.Reduce(node);
+  const size_t allocation_before = zone()->allocation_size();
+  EXPECT_FALSE(reducer.Reduce(store).Changed());
+  EXPECT_EQ(allocation_before, zone()->allocation_size());
+  EXPECT_CALL(editor, ReplaceWithValue(reload, load, store, _));
+  EXPECT_EQ(load, reducer.Reduce(reload).replacement());
+}
