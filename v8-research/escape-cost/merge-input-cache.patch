diff --git a/test/mjsunit/compiler/escape-analysis-merge-input-cache.js b/test/mjsunit/compiler/escape-analysis-merge-input-cache.js
new file mode 100644
index 00000000..14ca4766
--- /dev/null
+++ b/test/mjsunit/compiler/escape-analysis-merge-input-cache.js
@@ -0,0 +1,38 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax --turbo-escape --no-turbo-loop-peeling
+
+// Exercise several live fields through nested joins and repeated loop-phi
+// reductions, then materialize the object at a deoptimization point.
+function mergeFields(n, selector, deopt) {
+  const object = {a: 1, b: 2, c: 3};
+  for (let i = 0; i < n; ++i) {
+    if ((i + selector) & 1) {
+      object.a += object.b;
+      object.c = object.a - 1;
+    } else {
+      object.b = object.c + 2;
+      object.a = object.b + 1;
+    }
+    if (i % 3 === 0) {
+      object.c = object.a + object.b;
+    } else {
+      object.b += 2;
+    }
+    if (deopt && i === n - 1) %DeoptimizeNow();
+  }
+  return object.a * 10000 + object.b * 100 + object.c;
+}
+
+%PrepareFunctionForOptimization(mergeFields);
+const cases = [[0, 0], [1, 0], [1, 1], [5, 0], [5, 1], [12, 0], [12, 1]];
+const expected = cases.map(([n, selector]) => mergeFields(n, selector, false));
+%OptimizeFunctionOnNextCall(mergeFields);
+for (let i = 0; i < cases.length; ++i) {
+  assertEquals(expected[i], mergeFields(...cases[i], false));
+}
+assertOptimized(mergeFields);
+assertEquals(expected[6], mergeFields(...cases[6], true));
+assertUnoptimized(mergeFields);
