From f2ab8d37af54d3bcc0fa95b2c431b01cb9207d42 Mon Sep 17 00:00:00 2001
From: Mikhail Mikheev <16622558+mmv08@users.noreply.github.com>
Date: Wed, 21 Oct 2026 08:19:05 +0000
Subject: [PATCH 1/2] [turboshaft] Fold numeric bitcasts into stores

Store the input bits directly when a same-width numeric bitcast feeds
a store. Preserve access metadata and exclude atomic, trapping and
incompatible-alignment accesses. Cover positive and negative cases in
machine reducer graph tests.

TAG=agy
CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 .../turboshaft/machine-optimization-reducer.h |  32 ++++
 .../machine-optimization-reducer-unittest.cc  | 149 ++++++++++++++++++
 2 files changed, 181 insertions(+)

diff --git a/src/compiler/turboshaft/machine-optimization-reducer.h b/src/compiler/turboshaft/machine-optimization-reducer.h
index 2c1b5cec..ade97279 100644
--- a/src/compiler/turboshaft/machine-optimization-reducer.h
+++ b/src/compiler/turboshaft/machine-optimization-reducer.h
@@ -2244,6 +2244,38 @@ class MachineOptimizationReducer : public Next {
           maybe_trusted_pointer_tag);
     }
     if (ShouldSkipOptimizationStep()) goto no_change;
+    if (const ChangeOp* bitcast = matcher_.TryCast<ChangeOp>(value);
+        bitcast && bitcast->kind == ChangeOp::Kind::kBitcast &&
+        !kind.is_atomic && !kind.with_trap_handler &&
+        write_barrier == WriteBarrierKind::kNoWriteBarrier &&
+        stored_rep == any_of(MemoryRepresentation::Int32(),
+                             MemoryRepresentation::Uint32(),
+                             MemoryRepresentation::Int64(),
+                             MemoryRepresentation::Uint64(),
+                             MemoryRepresentation::Float32(),
+                             MemoryRepresentation::Float64()) &&
+        bitcast->to == stored_rep.ToRegisterRepresentation() &&
+        ((bitcast->from == RegisterRepresentation::Word32() &&
+          bitcast->to == RegisterRepresentation::Float32()) ||
+         (bitcast->from == RegisterRepresentation::Word64() &&
+          bitcast->to == RegisterRepresentation::Float64()) ||
+         (bitcast->from == RegisterRepresentation::Float32() &&
+          bitcast->to == RegisterRepresentation::Word32()) ||
+         (bitcast->from == RegisterRepresentation::Float64() &&
+          bitcast->to == RegisterRepresentation::Word64()))) {
+      MemoryRepresentation rep =
+          MemoryRepresentation::FromRegisterRepresentation(bitcast->from,
+                                                           false);
+      // A same-width bitcast does not change the stored bits. Keep the access
+      // kind unchanged, including its alignment requirements.
+      if (SupportedOperations::IsUnalignedStoreSupported(rep) ==
+              SupportedOperations::IsUnalignedStoreSupported(stored_rep) &&
+          SupportedOperations::IsUnalignedLoadSupported(rep) ==
+              SupportedOperations::IsUnalignedLoadSupported(stored_rep)) {
+        value = bitcast->input();
+        stored_rep = rep;
+      }
+    }
 #if V8_TARGET_ARCH_32_BIT
     if (kind.is_atomic && stored_rep.SizeInBytes() == 8) {
       // AtomicWord32PairOp (as used by Int64Lowering) cannot handle
diff --git a/test/unittests/compiler/turboshaft/machine-optimization-reducer-unittest.cc b/test/unittests/compiler/turboshaft/machine-optimization-reducer-unittest.cc
index 1f5db37a..95db0306 100644
--- a/test/unittests/compiler/turboshaft/machine-optimization-reducer-unittest.cc
+++ b/test/unittests/compiler/turboshaft/machine-optimization-reducer-unittest.cc
@@ -4,6 +4,7 @@
 
 #include "src/compiler/turboshaft/machine-optimization-reducer.h"
 
+#include "src/compiler/turboshaft/dead-code-elimination-reducer.h"
 #include "src/compiler/turboshaft/operations.h"
 #include "src/compiler/turboshaft/opmasks.h"
 #include "src/compiler/turboshaft/use-map.h"
@@ -559,4 +560,152 @@ TEST_F(MachineOptimizationReducerTest, SelfComparisonLessThan) {
   }
 }
 
+TEST_F(MachineOptimizationReducerTest, StoreBitcast) {
+  struct TestCase {
+    RegisterRepresentation from;
+    MemoryRepresentation stored_rep;
+  };
+  const TestCase cases[] = {
+      {RegisterRepresentation::Word32(), MemoryRepresentation::Float32()},
+      {RegisterRepresentation::Word64(), MemoryRepresentation::Float64()},
+      {RegisterRepresentation::Float32(), MemoryRepresentation::Int32()},
+      {RegisterRepresentation::Float32(), MemoryRepresentation::Uint32()},
+      {RegisterRepresentation::Float64(), MemoryRepresentation::Int64()},
+      {RegisterRepresentation::Float64(), MemoryRepresentation::Uint64()},
+  };
+  for (auto [from, stored_rep] : cases) {
+    MemoryRepresentation expected_rep =
+        MemoryRepresentation::FromRegisterRepresentation(from, false);
+    // Some targets have different alignment requirements for integer and
+    // floating-point accesses. The reduction conservatively excludes them.
+    if (SupportedOperations::IsUnalignedStoreSupported(stored_rep) !=
+            SupportedOperations::IsUnalignedStoreSupported(expected_rep) ||
+        SupportedOperations::IsUnalignedLoadSupported(stored_rep) !=
+            SupportedOperations::IsUnalignedLoadSupported(expected_rep)) {
+      continue;
+    }
+    for (bool other_use : {false, true}) {
+      const RegisterRepresentation reps[] = {RegisterRepresentation::WordPtr(),
+                                             RegisterRepresentation::WordPtr(),
+                                             from};
+      auto kind = StoreOp::Kind::MaybeUnaligned(stored_rep).NotLoadEliminable();
+      auto test = CreateFromGraph(base::VectorOf(reps), [=](auto& t) {
+        auto base = t.Capture(t.template GetParameter<WordPtr>(0), "base");
+        auto index = t.Capture(t.template GetParameter<WordPtr>(1), "index");
+        auto value = t.Capture(t.template GetParameter<Untagged>(2), "value");
+        V<Untagged> bitcast =
+            t.Asm().ReduceChange(value, ChangeOp::Kind::kBitcast,
+                                 ChangeOp::Assumption::kNoAssumption, from,
+                                 stored_rep.ToRegisterRepresentation());
+        t.Asm().Store(base, index, bitcast, kind, stored_rep,
+                      WriteBarrierKind::kNoWriteBarrier, 19, 2, true);
+        t.Capture(t.graph().LastOperation(), "store");
+        if (other_use) {
+          t.Asm().Return(bitcast);
+        } else {
+          t.Asm().Return(base);
+        }
+      });
+      test.Run<MachineOptimizationReducer>();
+      test.Run<DeadCodeEliminationReducer>();
+
+      const StoreOp* store = test.GetCapturedAs<StoreOp>("store");
+      ASSERT_NE(store, nullptr);
+      EXPECT_EQ(store->stored_rep, expected_rep);
+      EXPECT_TRUE(test.GetCapture("value").Is(store->value()));
+      EXPECT_TRUE(test.GetCapture("base").Is(store->base()));
+      ASSERT_TRUE(store->index().valid());
+      EXPECT_TRUE(test.GetCapture("index").Is(store->index().value()));
+      EXPECT_EQ(store->kind, kind);
+      EXPECT_EQ(store->offset, 19);
+      EXPECT_EQ(store->element_size_log2, 2);
+      EXPECT_EQ(store->write_barrier, WriteBarrierKind::kNoWriteBarrier);
+      EXPECT_FALSE(store->memory_order().has_value());
+      EXPECT_TRUE(store->maybe_initializing_or_transitioning);
+      EXPECT_EQ(store->trusted_pointer_tag(), kTrustedPointerNullTag);
+      EXPECT_EQ(test.CountOp(Opcode::kChange), other_use ? 1u : 0u);
+      if (other_use) {
+        const auto& ret =
+            test.graph().Get(test.graph().LastOperation()).Cast<ReturnOp>();
+        const ChangeOp* bitcast =
+            test.graph().Get(ret.return_values()[0]).TryCast<ChangeOp>();
+        ASSERT_NE(bitcast, nullptr);
+        EXPECT_EQ(bitcast->kind, ChangeOp::Kind::kBitcast);
+        EXPECT_TRUE(test.GetCapture("value").Is(bitcast->input()));
+      }
+    }
+  }
+}
+
+TEST_F(MachineOptimizationReducerTest, StoreBitcastRejectConversions) {
+  struct TestCase {
+    RegisterRepresentation from;
+    RegisterRepresentation to;
+    ChangeOp::Kind change;
+    MemoryRepresentation stored_rep;
+  };
+  const TestCase cases[] = {
+      {RegisterRepresentation::Float32(), RegisterRepresentation::Word32(),
+       ChangeOp::Kind::kBitcast, MemoryRepresentation::Uint16()},
+      {RegisterRepresentation::Word32(), RegisterRepresentation::Float32(),
+       ChangeOp::Kind::kBitcast, MemoryRepresentation::Float16()},
+      {RegisterRepresentation::Float32(), RegisterRepresentation::Float64(),
+       ChangeOp::Kind::kFloatConversion, MemoryRepresentation::Float64()},
+      {RegisterRepresentation::Word32(), RegisterRepresentation::Float32(),
+       ChangeOp::Kind::kSignedToFloat, MemoryRepresentation::Float32()},
+  };
+  for (auto [from, to, change, stored_rep] : cases) {
+    const RegisterRepresentation reps[] = {RegisterRepresentation::WordPtr(),
+                                           from};
+    auto test = CreateFromGraph(base::VectorOf(reps), [=](auto& t) {
+      auto base = t.template GetParameter<WordPtr>(0);
+      auto value = t.template GetParameter<Untagged>(1);
+      V<Untagged> converted = t.Asm().ReduceChange(
+          value, change, ChangeOp::Assumption::kNoAssumption, from, to);
+      t.Capture(converted, "converted");
+      t.Asm().Store(base, converted, StoreOp::Kind::MaybeUnaligned(stored_rep),
+                    stored_rep, WriteBarrierKind::kNoWriteBarrier);
+      t.Capture(t.graph().LastOperation(), "store");
+      t.Asm().Return(base);
+    });
+    test.Run<MachineOptimizationReducer>();
+    test.Run<DeadCodeEliminationReducer>();
+    const StoreOp* store = test.GetCapturedAs<StoreOp>("store");
+    ASSERT_NE(store, nullptr);
+    EXPECT_EQ(store->stored_rep, stored_rep);
+    EXPECT_TRUE(test.GetCapture("converted").Is(store->value()));
+    EXPECT_EQ(test.CountOp(Opcode::kChange), 1u);
+  }
+}
+
+TEST_F(MachineOptimizationReducerTest, StoreBitcastRejectAtomicAndTrapping) {
+  for (bool atomic : {false, true}) {
+    const RegisterRepresentation reps[] = {RegisterRepresentation::WordPtr(),
+                                           RegisterRepresentation::Float32()};
+    auto kind = atomic ? StoreOp::Kind::RawAligned().Atomic()
+                       : StoreOp::Kind::Trapping();
+    std::optional<AtomicMemoryOrder> order =
+        atomic ? std::make_optional(AtomicMemoryOrder::kSeqCst) : std::nullopt;
+    auto test = CreateFromGraph(base::VectorOf(reps), [=](auto& t) {
+      auto base = t.template GetParameter<WordPtr>(0);
+      auto value = t.template GetParameter<Float32>(1);
+      auto bitcast =
+          t.Capture(t.Asm().BitcastFloat32ToWord32(value), "bitcast");
+      t.Asm().Store(base, bitcast, kind, MemoryRepresentation::Uint32(),
+                    WriteBarrierKind::kNoWriteBarrier, order);
+      t.Capture(t.graph().LastOperation(), "store");
+      t.Asm().Return(base);
+    });
+    test.Run<MachineOptimizationReducer>();
+    test.Run<DeadCodeEliminationReducer>();
+    const StoreOp* store = test.GetCapturedAs<StoreOp>("store");
+    ASSERT_NE(store, nullptr);
+    EXPECT_EQ(store->stored_rep, MemoryRepresentation::Uint32());
+    EXPECT_TRUE(test.GetCapture("bitcast").Is(store->value()));
+    EXPECT_EQ(store->kind, kind);
+    EXPECT_EQ(store->memory_order(), order);
+    EXPECT_EQ(test.CountOp(Opcode::kChange), 1u);
+  }
+}
+
 }  // namespace v8::internal::compiler::turboshaft
