From be68467f90f6e7ce85fe213b23ccc06279fb11f9 Mon Sep 17 00:00:00 2001
From: Mikhail Mikheev <16622558+mmv08@users.noreply.github.com>
Date: Wed, 21 Oct 2026 08:21:22 +0000
Subject: [PATCH 2/2] [test] Check store bitcasts preserve Wasm memory bits

Exercise same-width stores and reinterpretations with unaligned accesses,
signed zero, subnormals, infinities and NaN payloads. Keep explicit bounds
checks enabled and verify out-of-bounds traps.

TAG=agy
CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 test/mjsunit/wasm/store-bitcast.js | 68 ++++++++++++++++++++++++++++++
 1 file changed, 68 insertions(+)
 create mode 100644 test/mjsunit/wasm/store-bitcast.js

diff --git a/test/mjsunit/wasm/store-bitcast.js b/test/mjsunit/wasm/store-bitcast.js
new file mode 100644
index 00000000..15e9f722
--- /dev/null
+++ b/test/mjsunit/wasm/store-bitcast.js
@@ -0,0 +1,68 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --no-liftoff --no-wasm-trap-handler
+
+d8.file.execute('test/mjsunit/wasm/wasm-module-builder.js');
+
+const builder = new WasmModuleBuilder();
+builder.addMemory(1, 1);
+builder.exportMemoryAs('memory');
+
+builder.addFunction('store32', makeSig([kWasmI32, kWasmI32], []))
+    .addBody([
+      kExprLocalGet, 0, kExprLocalGet, 1,
+      kExprF32ReinterpretI32, kExprF32StoreMem, 0, 1,
+    ]).exportFunc();
+builder.addFunction('store64', makeSig([kWasmI32, kWasmI64], []))
+    .addBody([
+      kExprLocalGet, 0, kExprLocalGet, 1,
+      kExprF64ReinterpretI64, kExprF64StoreMem, 0, 1,
+    ]).exportFunc();
+builder.addFunction('copy32', makeSig([kWasmI32, kWasmI32], []))
+    .addBody([
+      kExprLocalGet, 0, kExprLocalGet, 1, kExprF32LoadMem, 0, 0,
+      kExprI32ReinterpretF32, kExprI32StoreMem, 0, 1,
+    ]).exportFunc();
+builder.addFunction('copy64', makeSig([kWasmI32, kWasmI32], []))
+    .addBody([
+      kExprLocalGet, 0, kExprLocalGet, 1, kExprF64LoadMem, 0, 0,
+      kExprI64ReinterpretF64, kExprI64StoreMem, 0, 1,
+    ]).exportFunc();
+
+const {memory, store32, store64, copy32, copy64} = builder.instantiate().exports;
+const view = new DataView(memory.buffer);
+
+// Preserve every bit, including signed zero, subnormals, infinities and NaN
+// payloads. Both the source and destination addresses are unaligned.
+for (const bits of [
+  0, 0x80000000, 1, 0x3f800000, 0x7f800000, 0xff800000,
+  0x7fc00001, 0x7f800001, 0xffffffff,
+]) {
+  store32(6, bits);
+  assertEquals(bits, view.getUint32(7, true));
+  view.setUint32(33, bits, true);
+  view.setUint32(7, 0, true);
+  copy32(6, 33);
+  assertEquals(bits, view.getUint32(7, true));
+}
+for (const bits of [
+  0n, 0x8000000000000000n, 1n, 0x3ff0000000000000n,
+  0x7ff0000000000000n, 0xfff0000000000000n,
+  0x7ff8000000000001n, 0x7ff0000000000001n, 0xffffffffffffffffn,
+]) {
+  store64(6, bits);
+  assertEquals(bits, view.getBigUint64(7, true));
+  view.setBigUint64(33, bits, true);
+  view.setBigUint64(7, 0n, true);
+  copy64(6, 33);
+  assertEquals(bits, view.getBigUint64(7, true));
+}
+
+assertTraps(kTrapMemOutOfBounds, () => store32(65532, 0));
+assertTraps(kTrapMemOutOfBounds, () => store64(65528, 0n));
+assertTraps(kTrapMemOutOfBounds, () => copy32(65532, 33));
+assertTraps(kTrapMemOutOfBounds, () => copy64(65528, 33));
+assertTraps(kTrapMemOutOfBounds, () => copy32(6, 65534));
+assertTraps(kTrapMemOutOfBounds, () => copy64(6, 65530));
-- 
