+TEST_F(GraphReducerTest, RevisitConsumedBeforeQueueIsDrained) {
+  Node* leaf = graph()->NewNode(&kOpA0);
+  Node* first = graph()->NewNode(&kOpA1, leaf);
+  Node* second = graph()->NewNode(&kOpA1, leaf);
+  Node* end = graph()->NewNode(&kOpA2, first, second);
+  GraphReducer graph_reducer(zone(), graph(), tick_counter(), nullptr);
+  StrictMock<MockReducer> reducer;
+  graph_reducer.AddReducer(&reducer);
+  Sequence sequence;
+  EXPECT_CALL(reducer, Reduce(leaf)).InSequence(sequence);
+  EXPECT_CALL(reducer, Reduce(first)).InSequence(sequence).WillOnce([&](Node*) {
+    static_cast<AdvancedReducer::Editor&>(graph_reducer).Revisit(leaf);
+    return Reducer::NoChange();
+  });
+  // The second input reaches the queued leaf before the queue is drained.
+  EXPECT_CALL(reducer, Reduce(leaf)).InSequence(sequence);
+  EXPECT_CALL(reducer, Reduce(second)).InSequence(sequence);
+  EXPECT_CALL(reducer, Reduce(end)).InSequence(sequence);
+  graph_reducer.ReduceNode(end);
+}
+
 }  // namespace graph_reducer_unittest
 }  // namespace compiler
 }  // namespace internal
diff --git a/test/unittests/compiler/node-marker-unittest.cc b/test/unittests/compiler/node-marker-unittest.cc
new file mode 100644
index 00000000..de6f99cf
--- /dev/null
+++ b/test/unittests/compiler/node-marker-unittest.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/compiler/node-marker.h"
+
+#include "src/compiler/common-operator.h"
+#include "src/compiler/turbofan-graph.h"
+#include "test/unittests/test-utils.h"
+
+namespace v8::internal::compiler {
+
+class NodeMarkerTest : public TestWithZone {
+ protected:
+  TFGraph graph_{zone()};
+  CommonOperatorBuilder common_{zone()};
+};
+
+TEST_F(NodeMarkerTest, CompareAllStates) {
+  Node* node = graph_.NewNode(common_.Int32Constant(0));
+  // Exercise current states with both zero and nonzero epoch offsets, including
+  // offsets larger than the State type can represent.
+  for (int epoch = 0; epoch < 130; ++epoch) {
+    NodeMarker<uint8_t> marker(&graph_, 4);
+    for (uint8_t state = 0; state < 4; ++state) {
+      marker.Set(node, state);
+      for (uint8_t other = 0; other < 4; ++other) {
+        EXPECT_EQ(state == other, marker.Is(node, other));
+        EXPECT_EQ(state > other, marker.IsGreaterThan(node, other));
+      }
+    }
+  }
+}
+
+TEST_F(NodeMarkerTest, UntouchedNodesHaveStateZero) {
+  Node* old_node = graph_.NewNode(common_.Int32Constant(0));
+  NodeMarker<uint8_t> marker(&graph_, 4);
+  Node* new_node = graph_.NewNode(common_.Int32Constant(1));
+  for (Node* node : {old_node, new_node}) {
+    for (uint8_t other = 0; other < 4; ++other) {
+      EXPECT_EQ(other == 0, marker.Is(node, other));
+      EXPECT_FALSE(marker.IsGreaterThan(node, other));
+    }
+  }
+}
+
+TEST_F(NodeMarkerTest, PreviousEpochsHaveStateZero) {
+  Node* nodes[4];
+  NodeMarker<uint8_t> first(&graph_, 4);
+  for (uint8_t state = 0; state < 4; ++state) {
+    nodes[state] = graph_.NewNode(common_.Int32Constant(state));
+    first.Set(nodes[state], state);
+  }
+  // Include epoch differences that cannot be represented by the State type.
+  for (int epoch = 0; epoch < 130; ++epoch) {
+    NodeMarker<uint8_t> marker(&graph_, 4);
+    for (Node* node : nodes) {
+      for (uint8_t other = 0; other < 4; ++other) {
+        EXPECT_EQ(other == 0, marker.Is(node, other));
+        EXPECT_FALSE(marker.IsGreaterThan(node, other));
+      }
+    }
+  }
+}
+
+}  // namespace v8::internal::compiler
