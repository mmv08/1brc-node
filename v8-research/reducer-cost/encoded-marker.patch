--- a/src/compiler/node-marker.h
+++ b/src/compiler/node-marker.h
@@ -35,6 +35,20 @@ class NodeMarkerBase {
     node->set_mark(mark + mark_min_);
   }
 
+  V8_INLINE bool Is(const Node* node, Mark mark) {
+    DCHECK_LT(mark, mark_max_ - mark_min_);
+    DCHECK_LT(node->mark(), mark_max_);
+    // Marks from earlier markers have the local state zero.
+    return mark == 0 ? node->mark() <= mark_min_
+                     : node->mark() == mark_min_ + mark;
+  }
+
+  V8_INLINE bool IsGreaterThan(const Node* node, Mark mark) {
+    DCHECK_LT(mark, mark_max_ - mark_min_);
+    DCHECK_LT(node->mark(), mark_max_);
+    return node->mark() > mark_min_ + mark;
+  }
+
  private:
   Mark const mark_min_;
   Mark const mark_max_;
@@ -69,6 +83,14 @@ class NodeMarker : public NodeMarkerBase {
