     NodeMarkerBase::Set(node, static_cast<Mark>(state));
   }
+
+  V8_INLINE bool Is(const Node* node, State state) {
+    return NodeMarkerBase::Is(node, static_cast<Mark>(state));
+  }
+
+  V8_INLINE bool IsGreaterThan(const Node* node, State state) {
+    return NodeMarkerBase::IsGreaterThan(node, static_cast<Mark>(state));
+  }
