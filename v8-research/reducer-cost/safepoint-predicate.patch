+class ParkedPollingThread final : public base::Thread {
+ public:
+  explicit ParkedPollingThread(Heap* heap)
+      : base::Thread(base::Thread::Options("ParkedPollingThread")),
+        heap_(heap) {}
+
+  void Run() override {
+    LocalHeap local_heap(heap_, ThreadKind::kBackground);
+    CHECK(local_heap.IsParked());
+    ready_.Signal();
+    poll_.Wait();
+    local_heap.Safepoint();
+    CHECK(local_heap.IsParked());
+    polled_.Signal();
+    // Destruction needs the local-heaps mutex held by the safepoint scope.
+    finish_.Wait();
+  }
+
+  Heap* heap_;
+  base::Semaphore ready_{0};
+  base::Semaphore poll_{0};
+  base::Semaphore polled_{0};
+  base::Semaphore finish_{0};
+};
+
+TEST_F(SafepointTest, ParkedThreadCanPollDuringSafepoint) {
+  Heap* heap = i_isolate()->heap();
+  ParkedPollingThread thread(heap);
+  CHECK(thread.Start());
+  thread.ready_.Wait();
+  {
+    IsolateSafepointScope scope(heap);
+    thread.poll_.Signal();
+    // Polling must return while the request is still set, without waiting for
+    // the safepoint scope to exit or acknowledging an already parked thread.
+    thread.polled_.Wait();
+  }
+  thread.finish_.Signal();
+  thread.Join();
+}
