From 3eb4f01cf000164ffac1a01cadedc9ffd56bae12 Mon Sep 17 00:00:00 2001
From: Mikhail Mikheev <16622558+mmv08@users.noreply.github.com>
Date: Wed, 21 Oct 2026 08:05:50 +0000
Subject: [PATCH] [compiler] Inline ArrayBuffer byteLength access

Load the mutable byte length after validating the receiver maps and
shared bit. Preserve the builtin throw for shared buffers without
speculative deoptimization. Cover resizing, detachment, polymorphic
receivers and getter replacement.

TAG=agy
CONV=01a15ac7-b7fe-7dc2-ab61-5d14a81b88b5
---
 src/compiler/js-call-reducer.cc               |  53 +++++
 src/compiler/js-call-reducer.h                |   1 +
 .../compiler/array-buffer-byte-length.js      | 181 ++++++++++++++++++
 3 files changed, 235 insertions(+)
 create mode 100644 test/mjsunit/compiler/array-buffer-byte-length.js

diff --git a/src/compiler/js-call-reducer.cc b/src/compiler/js-call-reducer.cc
index 2fa7a3d2..33a188cf 100644
--- a/src/compiler/js-call-reducer.cc
+++ b/src/compiler/js-call-reducer.cc
@@ -5500,6 +5500,8 @@ Reduction JSCallReducer::ReduceJSCall(Node* node,
       return ReduceArrayIsArray(node);
     case Builtin::kArrayBufferIsView:
       return ReduceArrayBufferIsView(node);
+    case Builtin::kArrayBufferPrototypeGetByteLength:
+      return ReduceArrayBufferByteLengthAccessor(node);
     case Builtin::kDataViewPrototypeGetByteLength:
       // TODO(v8:11111): Optimize for JS_RAB_GSAB_DATA_VIEW_TYPE too.
       return ReduceArrayBufferViewByteLengthAccessor(node, JS_DATA_VIEW_TYPE,
@@ -9317,6 +9319,57 @@ Reduction JSCallReducer::ReduceArrayBufferIsView(Node* node) {
   return Changed(node);
 }
 
+Reduction JSCallReducer::ReduceArrayBufferByteLengthAccessor(Node* node) {
+  JSCallNode n(node);
+  Effect effect = n.effect();
+  TNode<JSArrayBuffer> receiver =
+      TNode<JSArrayBuffer>::UncheckedCast(n.receiver());
+  MapInference inference(broker(), receiver, effect);
+  if (!inference.HaveMaps() ||
+      !inference.AllOfInstanceTypesAre(JS_ARRAY_BUFFER_TYPE) ||
+      !inference.RelyOnMapsViaStability(dependencies())) {
+    return inference.NoChange();
+  }
+
+  JSCallReducerAssembler a(this, node, effect);
+  TNode<Word32T> bit_field = a.EnterMachineGraph<Word32T>(
+      a.LoadField<Word32T>(AccessBuilder::ForJSArrayBufferBitField(), receiver),
+      UseInfo::TruncatingWord32());
+  // ArrayBuffers and SharedArrayBuffers have the same instance type.
+  // Keep the builtin's throwing path rather than speculatively deoptimizing:
+  // getter calls need not have a CALL_IC slot to
+  // prevent deoptimization loops.
+  TNode<Word32T> is_shared = a.Word32And(
+      bit_field, a.Int32Constant(JSArrayBuffer::Bits::IsSharedBit::kMask));
+  a.MachineIf(is_shared)
+      .Then([&] {
+        Callable callable = CodeFactory::CallFunction(
+            isolate(), ConvertReceiverMode::kNotNullOrUndefined);
+        auto descriptor = Linkage::GetStubCallDescriptor(
+            graph()->zone(), callable.descriptor(), 1,
+            CallDescriptor::kNeedsFrameState);
+        a.MayThrow([&] {
+          return a.AddNode<Object>(graph()->NewNode(
+              common()->Call(descriptor),
+              jsgraph()->HeapConstantNoHole(callable.code()), n.target(),
+              jsgraph()->ConstantNoHole(JSParameterCount(0)), receiver,
+              n.context(), n.frame_state(), a.effect(), a.control()));
+        });
+        a.Unreachable();
+      })
+      .ExpectFalse();
+
+  // This mutable field is updated by both resizing and detachment (to zero).
+  TNode<UintPtrT> value = a.EnterMachineGraph<UintPtrT>(
+      a.LoadField<UintPtrT>(AccessBuilder::ForJSArrayBufferByteLength(),
+                            receiver),
+      UseInfo::Word());
+  TNode<Number> result = a.ExitMachineGraph<Number>(
+      value, MachineType::PointerRepresentation(),
+      TypeCache::Get()->kJSArrayBufferByteLengthType);
+  return ReplaceWithSubgraph(&a, result);
+}
+
 Reduction JSCallReducer::ReduceArrayBufferViewAccessor(
     Node* node, InstanceType instance_type, FieldAccess const& access,
     Builtin builtin) {
diff --git a/src/compiler/js-call-reducer.h b/src/compiler/js-call-reducer.h
index 0d4d10d6..64b0f6be 100644
--- a/src/compiler/js-call-reducer.h
+++ b/src/compiler/js-call-reducer.h
@@ -239,6 +239,7 @@ class V8_EXPORT_PRIVATE JSCallReducer final : public AdvancedReducer {
       InstanceType collection_iterator_instance_type_last);
 
   Reduction ReduceArrayBufferIsView(Node* node);
+  Reduction ReduceArrayBufferByteLengthAccessor(Node* node);
   Reduction ReduceArrayBufferViewAccessor(Node* node,
                                           InstanceType instance_type,
                                           FieldAccess const& access,
diff --git a/test/mjsunit/compiler/array-buffer-byte-length.js b/test/mjsunit/compiler/array-buffer-byte-length.js
new file mode 100644
index 00000000..4452f57b
--- /dev/null
+++ b/test/mjsunit/compiler/array-buffer-byte-length.js
@@ -0,0 +1,181 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Flags: --allow-natives-syntax --turbofan
+
+(function NormalAndDetached() {
+  function byteLength(buffer) {
+    return buffer.byteLength;
+  }
+  const buffer = new ArrayBuffer(8);
+  const empty = new ArrayBuffer(0);
+  %PrepareFunctionForOptimization(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertEquals(0, byteLength(empty));
+  %OptimizeFunctionOnNextCall(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertOptimized(byteLength);
+  assertEquals(0, byteLength(empty));
+
+  %ArrayBufferDetach(buffer);
+  assertEquals(0, byteLength(buffer));
+  // A buffer that was already detached must also be accepted after tier-up.
+  %PrepareFunctionForOptimization(byteLength);
+  %OptimizeFunctionOnNextCall(byteLength);
+  assertEquals(0, byteLength(buffer));
+  assertOptimized(byteLength);
+})();
+
+(function Resizable() {
+  function byteLength(buffer) {
+    return buffer.byteLength;
+  }
+  const buffer = new ArrayBuffer(8, {maxByteLength: 32});
+  %PrepareFunctionForOptimization(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertEquals(8, byteLength(buffer));
+  %OptimizeFunctionOnNextCall(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertOptimized(byteLength);
+  buffer.resize(0);
+  assertEquals(0, byteLength(buffer));
+  buffer.resize(24);
+  assertEquals(24, byteLength(buffer));
+  %ArrayBufferDetach(buffer);
+  assertEquals(0, byteLength(buffer));
+})();
+
+(function SharedWithArrayBufferPrototype() {
+  function byteLength(buffer) {
+    try {
+      return buffer.byteLength;
+    } catch (error) {
+      if (error instanceof TypeError) return -1;
+      throw error;
+    }
+  }
+  const buffer = new ArrayBuffer(8);
+  // These buffers have different maps but the same instance type and getter.
+  // Include both maps in the feedback so the shared test cannot be bypassed
+  // by deoptimizing on an unexpected receiver map.
+  const shared = Reflect.construct(SharedArrayBuffer, [8], ArrayBuffer);
+  const growable = Reflect.construct(
+      SharedArrayBuffer, [8, {maxByteLength: 16}], ArrayBuffer);
+  assertSame(ArrayBuffer.prototype, Object.getPrototypeOf(shared));
+  assertSame(ArrayBuffer.prototype, Object.getPrototypeOf(growable));
+  %PrepareFunctionForOptimization(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertEquals(-1, byteLength(shared));
+  assertEquals(-1, byteLength(growable));
+  assertEquals(8, byteLength(buffer));
+  %OptimizeFunctionOnNextCall(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertOptimized(byteLength);
+  // Keep the handler inside the optimized function to test exception edges.
+  assertEquals(-1, byteLength(shared));
+  assertOptimized(byteLength);
+  assertEquals(-1, byteLength(growable));
+  assertOptimized(byteLength);
+  assertEquals(8, byteLength(buffer));
+})();
+
+(function BorrowedGetter() {
+  const getter =
+      Object.getOwnPropertyDescriptor(ArrayBuffer.prototype, 'byteLength').get;
+  function byteLength(receiver) {
+    return getter.call(receiver);
+  }
+  const buffer = new ArrayBuffer(8);
+  %PrepareFunctionForOptimization(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertEquals(8, byteLength(buffer));
+  %OptimizeFunctionOnNextCall(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertOptimized(byteLength);
+  for (const receiver of [
+    undefined, null, 0, {}, Object.create(ArrayBuffer.prototype),
+    new Uint8Array(8), new DataView(buffer), new SharedArrayBuffer(8),
+    new Proxy(buffer, {})
+  ]) {
+    assertThrows(() => byteLength(receiver), TypeError);
+  }
+})();
+
+(function ResizeInLoop() {
+  let resize = false;
+  function mutate(buffer, iteration) {
+    if (resize && iteration < 2) buffer.resize(iteration === 0 ? 2 : 12);
+  }
+  %NeverOptimizeFunction(mutate);
+  function sumByteLengths(buffer) {
+    let sum = 0;
+    for (let i = 0; i < 3; ++i) {
+      sum += buffer.byteLength;
+      mutate(buffer, i);
+    }
+    return sum;
+  }
+  const buffer = new ArrayBuffer(8, {maxByteLength: 16});
+  %PrepareFunctionForOptimization(sumByteLengths);
+  assertEquals(24, sumByteLengths(buffer));
+  assertEquals(24, sumByteLengths(buffer));
+  %OptimizeFunctionOnNextCall(sumByteLengths);
+  assertEquals(24, sumByteLengths(buffer));
+  assertOptimized(sumByteLengths);
+  // Calls can change length without changing the receiver's map.
+  resize = true;
+  assertEquals(22, sumByteLengths(buffer));  // 8 + 2 + 12.
+  assertEquals(12, buffer.byteLength);
+})();
+
+(function DetachInLoop() {
+  let detach = false;
+  function mutate(buffer, iteration) {
+    if (detach && iteration === 0) %ArrayBufferDetach(buffer);
+  }
+  %NeverOptimizeFunction(mutate);
+  function sumByteLengths(buffer) {
+    let sum = 0;
+    for (let i = 0; i < 3; ++i) {
+      sum += buffer.byteLength;
+      mutate(buffer, i);
+    }
+    return sum;
+  }
+  const buffer = new ArrayBuffer(8);
+  %PrepareFunctionForOptimization(sumByteLengths);
+  assertEquals(24, sumByteLengths(buffer));
+  assertEquals(24, sumByteLengths(buffer));
+  %OptimizeFunctionOnNextCall(sumByteLengths);
+  assertEquals(24, sumByteLengths(buffer));
+  assertOptimized(sumByteLengths);
+  detach = true;
+  assertEquals(8, sumByteLengths(buffer));  // 8 + 0 + 0.
+  assertEquals(0, buffer.byteLength);
+})();
+
+(function ReplacedInheritedGetter() {
+  function byteLength(buffer) {
+    return buffer.byteLength;
+  }
+  const buffer = new ArrayBuffer(8);
+  const descriptor =
+      Object.getOwnPropertyDescriptor(ArrayBuffer.prototype, 'byteLength');
+  %PrepareFunctionForOptimization(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertEquals(8, byteLength(buffer));
+  %OptimizeFunctionOnNextCall(byteLength);
+  assertEquals(8, byteLength(buffer));
+  assertOptimized(byteLength);
+  try {
+    Object.defineProperty(ArrayBuffer.prototype, 'byteLength', {
+      get() { return 99; },
+      configurable: true
+    });
+    assertEquals(99, byteLength(buffer));
+  } finally {
+    Object.defineProperty(ArrayBuffer.prototype, 'byteLength', descriptor);
+  }
+  assertEquals(8, byteLength(buffer));
+})();
-- 
