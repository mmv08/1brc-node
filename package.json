{
  "name": "1brc-node",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "./run.sh",
    "start:node": "ENGINE=node ./run.sh",
    "start:wasm": "ENGINE=wasm ./run.sh",
    "build:wasm": "node tools/build-wasm.mjs",
    "format:c": "node tools/format-c.mjs",
    "check:c": "node tools/format-c.mjs --check",
    "test": "node --test test/*.test.mjs test/node/*.test.mjs",
    "test:node": "node --test test/node/*.test.mjs",
    "test:wasm": "node --test test/calculate.test.mjs test/wasm.test.mjs",
    "generate": "node tools/generate.mjs",
    "bench": "node tools/compare.mjs node-vs-wasm",
    "bench:node": "ENGINE=node node tools/compare.mjs node",
    "bench:wasm": "ENGINE=wasm node tools/compare.mjs wasm",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "wabt": "1.0.39"
  }
}
